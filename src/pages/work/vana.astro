---
/**
 * Vana — product story
 * URL: /work/vana
 *
 * The second hand-built work page, after reap-capital.astro, and the first
 * for something of our own. Same contract: content/work/vana.mdx sets
 * `story: true`, the generic [...slug] template skips it, and this file owns
 * the URL. Nav, Cta and Footer stay.
 *
 * Where Reap drops the reader onto ink, Vana drops them into the app's own
 * light: warm paper, terracotta, sage, an ink-brown for type. The palette is
 * Vana's, not the site's, and is declared once on .story below. The design
 * system chapter flips to ink so the page still changes temperature.
 *
 * Content lives in @/data/vana.ts. The app is in development, so a lot of it
 * is draft copy and every striped box is a slot for a capture still to come.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/sections/Cta.astro';
import {
  hero,
  stats,
  product,
  chapters,
  rituals,
  journey,
  moods,
  journal,
  swatches,
  brandSlots,
  components,
  type,
  engineering,
  milestones,
  stack,
} from '@/data/vana';
import feature from '@/assets/work/vana/feature.webp';
import cover from '@/assets/work/vana/cover.webp';

// Same ordering as the generic template, so "next" agrees with the grid.
const projects = (
  await getCollection(
    'work',
    ({ data }) => (import.meta.env.PROD ? data.draft !== true : true) && !data.parent
  )
).sort((a, b) => a.data.order - b.data.order);

const index = projects.findIndex((project) => project.id === 'vana');
if (index === -1) throw new Error('vana is missing from src/content/work');

const project = projects[index];
const next = projects[(index + 1) % projects.length];
const nextImage = next.data.feature ?? next.data.cover;

const journeyPct = Math.round((journey.day / journey.days) * 100);
---

<SiteLayout
  title={project.data.title}
  description={project.data.description}
  image={cover.src}
  imageAlt={project.data.coverAlt ?? project.data.title}
  navContext="vana"
>
  <article class="story">
    {/* --- hero: full-bleed, the feature photograph fading into paper ----- */}
    <header class="hero">
      <Image
        src={feature}
        alt=""
        layout="none"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        class="hero__img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__body shell">
        <p class="hero__eyebrow label-mono">
          {hero.eyebrow.map((item) => <span>{item}</span>)}
        </p>
        <h1 class="display-hero m-0">
          a calmer way<br />to <em>show up.</em>
        </h1>
        <div class="hero__foot">
          <p class="hero__intro">{hero.intro}</p>
          <div class="hero__scroll label-mono" aria-hidden="true">
            <span>scroll</span>
            <span class="hero__scroll-line"></span>
          </div>
        </div>
      </div>
    </header>

    {/* --- the shape of it --------------------------------------------- */}
    <section class="shell" aria-label="The shape of the product">
      <div class="stats" data-reveal>
        {
          stats.map((stat) => (
            <div class="stats__item">
              <div class="stats__value">{stat.value}</div>
              <div class="stats__label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* --- 01 the app ---------------------------------------------------- */}
    <section class="product shell" aria-labelledby="product-title">
      <div class="product__head" data-reveal>
        <div>
          <p class="eyebrow label-mono">01 · THE APP</p>
          <h2 class="product__title display-section" id="product-title">
            built to be <em>closed.</em>
          </h2>
        </div>
        <p class="product__intro">{product.intro}</p>
      </div>

      <div class="product__cover" data-reveal>
        <Image
          src={cover}
          alt="The Vana journey screen on an iPhone, resting on a slatted wooden bench"
          layout="none"
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          class="product__cover-img"
        />
        {
          product.url ? (
            <a class="pill label-mono" href={product.url} target="_blank" rel="noopener noreferrer">
              {product.cta} ⟶
            </a>
          ) : (
            <span class="pill pill--quiet label-mono">{product.cta}</span>
          )
        }
      </div>

      <div class="product__shots" data-reveal>
        {product.shots.map((label) => <Placeholder label={label} class="product__shot" />)}
      </div>

      <div class="notes" data-reveal>
        {
          product.notes.map((note) => (
            <div class="notes__item">
              <span class="notes__label label-mono">{note.label}</span>
              {note.text}
            </div>
          ))
        }
      </div>
    </section>

    {/* --- the ledger: sticky index + six chapters ------------------------ */}
    <section class="ledger shell" aria-labelledby="ledger-title">
      <aside class="ledger__index">
        <p class="eyebrow label-mono">THE PRODUCT</p>
        <h2 class="ledger__title" id="ledger-title">
          six <em>chapters.</em>
        </h2>
        <ol class="ledger__list">
          {
            chapters.map((chapter) => (
              <li>
                <a href={`#ch-${chapter.num}`}>
                  <span class="ledger__num label-mono">{chapter.num}</span>
                  <span>{chapter.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <div class="ledger__body">
        {/* 02 rituals */}
        <article class="ch" id="ch-02" data-reveal>
          <p class="eyebrow label-mono">02 · RITUALS</p>
          <h3 class="ch__title">the day, <em>in two halves.</em></h3>
          <p class="ch__intro">
            Not a list of habits but two rituals: one that opens the day, one that closes it. Each
            habit is stacked on the one before it, so the morning reads like a sentence rather than
            a checklist. When the last box is ticked the ritual folds away and the app says well
            done and means it.
          </p>

          <div class="rituals">
            {
              rituals.map((ritual) => (
                <div class="ritual" data-done={ritual.habits.every((h) => h.done)}>
                  <div class="ritual__head">
                    <div>
                      <span class="ritual__window label-mono">{ritual.window}</span>
                      <span class="ritual__name">{ritual.name}</span>
                    </div>
                    <span class="ritual__summary">{ritual.summary}</span>
                  </div>
                  <ol class="habits">
                    {ritual.habits.map((habit) => (
                      <li class="habit" data-done={habit.done}>
                        <span class="habit__check" aria-hidden="true">
                          {habit.done && (
                            <svg viewBox="0 0 12 12" width="12" height="12">
                              <path
                                d="M2.5 6.5l2.2 2.2L9.5 3.7"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          )}
                        </span>
                        <span class="habit__body">
                          <span class="habit__name">{habit.name}</span>
                          <span class="habit__after">
                            {habit.after} · {habit.dur}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>

          <div class="ch__pair">
            <Placeholder label="screen — ritual complete state" class="ch__shot" />
            <Placeholder label="screen — evening ritual, 9:00 pm" class="ch__shot" />
          </div>
        </article>

        {/* 03 journeys */}
        <article class="ch" id="ch-03" data-reveal>
          <p class="eyebrow label-mono">03 · JOURNEYS</p>
          <h3 class="ch__title">six weeks, <em>three phases.</em></h3>
          <p class="ch__intro">
            A journey is the reason the rituals exist. You pick one — becoming a morning person,
            say — and it lays out six weeks in three phases. Foundation sets the core habits.
            Expansion grows them and adds one. Integration grows them again. Nothing from an earlier
            phase is ever taken away.
          </p>

          <div class="journey">
            <div class="journey__head">
              <div>
                <span class="journey__kicker label-mono">YOUR JOURNEY · WEEK 1 OF 6</span>
                <span class="journey__name">{journey.name}</span>
              </div>
              <div class="journey__dial" style={`--pct: ${journeyPct}`}>
                <span class="journey__day">{journey.day}</span>
                <span class="journey__of label-mono">OF {journey.days} DAYS</span>
              </div>
            </div>
            <ol class="phases">
              {
                journey.phases.map((phase) => (
                  <li class="phase" data-state={phase.state}>
                    <span class="phase__num label-mono">{phase.num}</span>
                    <div class="phase__body">
                      <div class="phase__row">
                        <span class="phase__name">{phase.name}</span>
                        <span class="phase__weeks label-mono">{phase.weeks}</span>
                      </div>
                      <p class="phase__desc">{phase.desc}</p>
                      <span class="phase__bar" aria-hidden="true">
                        <span class="phase__fill" style={`width: ${phase.progress}%`}></span>
                      </span>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <div class="ch__pair ch__pair--wide">
            <Placeholder label="screen — journey library" class="ch__shot" />
            <Placeholder label="screen — phase detail" class="ch__shot" />
          </div>
        </article>

        {/* 04 journal */}
        <article class="ch" id="ch-04" data-reveal>
          <p class="eyebrow label-mono">04 · JOURNAL</p>
          <h3 class="ch__title">how was <em>today?</em></h3>

          <div class="journal">
            <div class="journal__text">
              <p class="ch__intro journal__intro">
                The evening asks one question and offers five weathers to answer it. Then a prompt,
                if you want one, and a page that saves as you type. Entries feed the morning letter,
                so the app can say <em>you showed up yesterday</em> and be right.
              </p>

              <div class="journal__card">
                <span class="journal__greeting">{journal.greeting}</span>
                <ul class="moods">
                  {
                    moods.map((mood) => (
                      <li class="mood">
                        <span class="mood__glyph" aria-hidden="true">
                          {mood.glyph}
                        </span>
                        <span class="mood__label label-mono">{mood.label.toUpperCase()}</span>
                      </li>
                    ))
                  }
                </ul>
                <div class="prompt">
                  <span class="prompt__kind label-mono">{journal.promptKind}</span>
                  <span class="prompt__text">{journal.prompt}</span>
                  <span class="prompt__field">Start writing…</span>
                </div>
              </div>
            </div>

            <figure class="journal__shot">
              <Image
                src={journal.shot}
                alt={journal.shotAlt}
                layout="none"
                widths={[640, 960, 1280]}
                sizes="(max-width: 800px) 100vw, 42vw"
                class="journal__shot-img"
              />
            </figure>
          </div>
        </article>

        {/* 05 brand */}
        <article class="ch" id="ch-05" data-reveal>
          <p class="eyebrow label-mono">05 · BRAND</p>
          <h3 class="ch__title">warm, <em>unhurried.</em></h3>
          <p class="ch__intro">
            {/* TODO: draft copy. Rewrite once the identity is designed. */}
            Terracotta and peach off a sunlit table, sage for the tick, paper for everything else.
            An editorial serif that sounds like a letter, not a dashboard. The identity is still in
            the studio; the tiles below are where it will land.
          </p>

          <div class="brand">
            <div class="brand__tile brand__tile--hero brand__tile--terracotta">
              <Placeholder label="logomark" class="brand__slot" />
              <span class="brand__tag brand__tag--on-dark brand__tag--corner label-mono"
                >logomark — on terracotta</span
              >
            </div>
            <div class="brand__tile brand__tile--wide brand__tile--paper">
              <span class="brand__word" aria-hidden="true">vana</span>
              <span class="brand__tag brand__tag--on-light brand__tag--corner label-mono"
                >wordmark — serif TBD · ink #2B2521 on paper #F4EFE8</span
              >
            </div>
            {
              swatches.map((swatch) => (
                <div
                  class="brand__tile brand__tile--swatch"
                  style={`background: var(--vana-${swatch.token})`}
                  aria-label={`${swatch.name} swatch`}
                >
                  <span
                    class:list={[
                      'brand__tag label-mono',
                      swatch.onDark ? 'brand__tag--on-dark' : 'brand__tag--on-light',
                    ]}
                  >
                    {swatch.name} {swatch.hex}
                  </span>
                </div>
              ))
            }
            {
              brandSlots.map((label) => (
                <div class="brand__tile brand__tile--slot">
                  <span class="brand__tag label-mono">{label}</span>
                </div>
              ))
            }
          </div>
        </article>

        {/* 06 design system — an ink island in the warm page */}
        <article class="ch system" id="ch-06" data-reveal>
          <p class="eyebrow label-mono">06 · DESIGN SYSTEM</p>
          <h3 class="ch__title">the system <em>under the calm.</em></h3>
          <p class="ch__intro">
            Two type faces, five colours, a dozen components. Everything the app draws comes from
            one file, so a habit row on the journey screen is the same habit row in the morning. The
            calm is a system, not a mood.
          </p>

          <div class="type">
            {
              type.map((face) => (
                <div class="type__row">
                  <span class="type__role label-mono">{face.role}</span>
                  <span class="type__sample" data-role={face.role.toLowerCase()}>
                    {face.sample}
                  </span>
                  <span class="type__face">{face.face}</span>
                </div>
              ))
            }
          </div>

          <div class="components">
            {
              components.map((label) => (
                <div class="tile">
                  <span class="tile__tag label-mono">{label}</span>
                </div>
              ))
            }
          </div>
        </article>

        {/* 07 under the hood */}
        <article class="ch" id="ch-07" data-reveal>
          <p class="eyebrow label-mono">07 · UNDER THE HOOD</p>
          <h3 class="ch__title">quiet <em>engineering.</em></h3>
          <p class="ch__intro">
            A calm product needs a boring backend. Every tick lands on the device first and syncs
            when it can. Notifications are rationed to one per ritual. The morning letter is written
            overnight by a job that reads yesterday, not by a model that guesses.
          </p>

          <Placeholder label="diagram — data model, sync and the nightly letter" class="hood__shot" />

          <div class="hood__grid">
            {
              engineering.map((cap) => (
                <div class="hood__cap">
                  <strong>{cap.title}</strong>
                  {cap.desc}
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </section>

    {/* --- where it stands ----------------------------------------------- */}
    <section class="status shell" aria-label="Where the build stands" data-reveal>
      <p class="eyebrow label-mono">WHERE IT STANDS</p>
      <ol class="milestones">
        {
          milestones.map((m) => (
            <li class="milestone" data-state={m.state}>
              <span class="milestone__dot" aria-hidden="true"></span>
              <span class="milestone__label">{m.label}</span>
              <span class="milestone__when label-mono">{m.when.toUpperCase()}</span>
            </li>
          ))
        }
      </ol>
    </section>

    {/* --- stack ---------------------------------------------------------- */}
    <section class="stack shell" aria-label="Stack and tools" data-reveal>
      <p class="eyebrow label-mono">STACK &amp; TOOLS</p>
      <div class="stack__groups">
        {
          stack.map((group) => (
            <div>
              <div class="stack__label label-mono">{group.label}</div>
              {group.items.join(' · ')}
            </div>
          ))
        }
      </div>
    </section>

    {/* --- next project: the same full-bleed door the template uses -------- */}
    <a class="nextup" href={'/work/' + next.id} data-card>
      {
        nextImage && (
          <Image
            src={nextImage}
            alt=""
            layout="none"
            widths={[768, 1280, 1920]}
            sizes="100vw"
            class="nextup__img"
          />
        )
      }
      <div class="nextup__body shell">
        <span class="label-mono">NEXT PROJECT</span>
        <span class="nextup__title">{next.data.title}</span>
      </div>
    </a>
  </article>

  <Cta />
</SiteLayout>

<style>
  /* Vana's palette, read off the mocks. Literal on purpose: it's the app's,
     not the site's. Pinned in both colour schemes the way Reap pins ink. */
  .story {
    --vana-paper: #f4efe8;
    --vana-card: #faf7f2;
    --vana-cream: #ebe4da;
    --vana-terracotta: #c8623c;
    --vana-peach: #e8b5a2;
    --vana-sage: #6e7d64;
    --vana-ink: #2b2521;
    --vana-ink-soft: #55493f;
    --vana-mute: #8c8078;
    --vana-line: rgb(43 37 33 / 0.12);

    --color-background: var(--vana-paper);
    --color-background-secondary: var(--vana-cream);
    --color-foreground: var(--vana-ink);
    --color-foreground-secondary: var(--vana-ink-soft);
    --color-foreground-muted: var(--vana-mute);
    --color-border: var(--vana-line);
    --color-border-strong: rgb(43 37 33 / 0.24);
    --color-primary: var(--vana-ink);
    --color-primary-foreground: var(--vana-paper);
    --color-ring: var(--vana-ink);
    --dim: var(--vana-mute);
    --hairline: 1px solid var(--vana-line);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* The bar frosts to the page ground once scrolled; on this page the ground
     is paper, not ice. Scoped to the page file, so nothing else sees it. */
  :global(#sw-nav.is-scrolled) {
    --color-background: #f4efe8;
  }

  /* The lighter second half of every headline — same move as the site's
     display <em>, read off the same tokens. */
  .story em {
    font-style: var(--display-em-style);
    font-weight: var(--display-em-weight);
    font-stretch: var(--display-em-stretch);
    letter-spacing: var(--display-em-tracking);
  }

  /* Placeholders stay on the warm ground whatever the colour scheme. */
  .story :global(.placeholder) {
    background-color: var(--vana-cream);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(43 37 33 / 0.06) 0,
      rgb(43 37 33 / 0.06) 9px,
      transparent 9px,
      transparent 18px
    );
  }

  .story :global(.placeholder__label) {
    color: rgb(43 37 33 / 0.5);
    background: rgb(250 247 242 / 0.85);
  }

  .eyebrow {
    margin: 0;
    color: var(--dim);
  }

  .pill {
    padding: 14px 20px;
    border-radius: var(--radius-full);
    background: var(--vana-ink);
    color: var(--vana-paper);
  }

  .pill--quiet {
    background: rgb(43 37 33 / 0.55);
    color: var(--vana-paper);
    backdrop-filter: blur(8px);
  }

  /* --- hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 92svh;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  /* Two washes: paper rising from the foot so the story picks up where the
     photograph leaves off, and paper pooling in from the left so the headline
     sits on near-solid ground while the phone, top right, stays in full
     colour. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        180deg,
        rgb(244 239 232 / 0.2) 0%,
        rgb(244 239 232 / 0) 28%,
        rgb(244 239 232 / 0.7) 62%,
        var(--vana-paper) 100%
      ),
      linear-gradient(
        100deg,
        rgb(244 239 232 / 0.92) 0%,
        rgb(244 239 232 / 0.8) 38%,
        rgb(244 239 232 / 0) 68%
      );
  }

  .hero__body {
    padding-block: 150px 64px;
    animation: sw-rise 0.9s var(--ease-sw) both;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0 0 28px;
    color: var(--vana-ink-soft);
  }

  .hero__foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-top: 40px;
  }

  .hero__intro {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--vana-ink);
    text-wrap: pretty;
  }

  .hero__scroll {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    color: var(--vana-mute);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 36px;
    background: var(--vana-ink);
    animation: sw-scrollpulse 1.6s ease-in-out infinite;
  }

  /* --- the shape of it --------------------------------------------------- */

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
  }

  .stats__item {
    padding: 36px 28px 36px 24px;
    border-right: var(--hairline);
  }

  .stats__item:first-child {
    padding-left: 0;
  }

  .stats__item:last-child {
    border-right: 0;
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: min(5vw, 72px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
    color: var(--vana-terracotta);
  }

  .stats__label {
    max-width: 220px;
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--vana-mute);
  }

  /* --- 01 the app -------------------------------------------------------- */

  .product {
    padding-block: 96px 64px;
  }

  .product__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
  }

  .product__title {
    margin: 20px 0 0;
  }

  .product__intro {
    margin: 0;
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--vana-ink-soft);
  }

  .product__cover {
    position: relative;
    margin-top: 56px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--vana-cream);
  }

  .product__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .product__cover .pill {
    position: absolute;
    right: 24px;
    bottom: 24px;
  }

  .product__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  /* Phone captures are portrait; the slot is shaped for them. */
  .product__shots :global(.product__shot) {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    border: 1px solid var(--vana-line);
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 48px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--vana-ink-soft);
  }

  .notes__item {
    padding-top: 16px;
    border-top: var(--hairline);
  }

  .notes__label {
    display: block;
    margin-bottom: 10px;
    color: var(--vana-ink);
  }

  /* --- the ledger -------------------------------------------------------- */

  .ledger {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 64px;
    padding-block: 64px;
  }

  .ledger::before {
    content: '';
    grid-column: 1 / -1;
    border-top: var(--hairline);
    margin-bottom: -16px;
  }

  .ledger__index {
    position: sticky;
    top: calc(var(--sw-nav-h, 76px) + 28px);
    align-self: start;
  }

  .ledger__title {
    margin: 24px 0 32px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 56px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .ledger__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }

  .ledger__list a {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-top: var(--hairline);
    color: var(--vana-ink-soft);
  }

  .ledger__num {
    padding-top: 2px;
    color: var(--dim);
  }

  .ledger__body {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  .ch {
    scroll-margin-top: calc(var(--sw-nav-h, 76px) + 28px);
  }

  .ch__title {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: min(4.4vw, 64px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .ch__intro {
    max-width: 640px;
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--vana-ink-soft);
  }

  .ch__intro em {
    font-style: italic;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .ch__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }

  .ch__pair :global(.ch__shot) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--vana-line);
  }

  .ch__pair--wide :global(.ch__shot) {
    aspect-ratio: 16 / 10;
  }

  /* 02 rituals — the app's ritual card, drawn in HTML so the chapter shows
     the product rather than describing it. */

  .rituals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }

  .ritual {
    padding: 22px 22px 14px;
    border-radius: var(--radius-lg);
    background: var(--vana-card);
    border: 1px solid var(--vana-line);
    box-shadow: 0 18px 40px -28px rgb(43 37 33 / 0.35);
  }

  .ritual__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: var(--hairline);
  }

  .ritual__window {
    display: block;
    margin-bottom: 8px;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vana-terracotta);
  }

  .ritual__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .ritual__summary {
    font-size: 12px;
    color: var(--vana-mute);
    text-align: right;
  }

  .habits {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .habit {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid rgb(43 37 33 / 0.06);
  }

  .habit:last-child {
    border-bottom: 0;
  }

  .habit__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    border: 1.5px solid rgb(43 37 33 / 0.2);
    color: var(--vana-paper);
  }

  .habit[data-done='true'] .habit__check {
    border-color: var(--vana-sage);
    background: var(--vana-sage);
  }

  .habit__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .habit__name {
    font-size: 15px;
    font-weight: 500;
  }

  .habit[data-done='true'] .habit__name {
    color: var(--vana-mute);
    text-decoration: line-through;
    text-decoration-color: rgb(43 37 33 / 0.3);
  }

  .habit__after {
    font-size: 12px;
    line-height: 1.4;
    color: var(--vana-mute);
  }

  /* 03 journeys */

  .journey {
    margin-top: 36px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--vana-card);
    border: 1px solid var(--vana-line);
    box-shadow: 0 18px 40px -28px rgb(43 37 33 / 0.35);
  }

  .journey__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: var(--hairline);
  }

  .journey__kicker {
    display: block;
    margin-bottom: 10px;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vana-mute);
  }

  .journey__name {
    display: block;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 30px;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* A ring drawn with a conic gradient: --pct is the journey's percent. */
  .journey__dial {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, var(--vana-card) 84%, transparent 85%),
      conic-gradient(
        var(--vana-sage) calc(var(--pct) * 1%),
        rgb(43 37 33 / 0.08) calc(var(--pct) * 1%)
      );
  }

  .journey__day {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .journey__of {
    margin-top: 6px;
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--vana-mute);
  }

  .phases {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .phase {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid rgb(43 37 33 / 0.06);
  }

  .phase:last-child {
    border-bottom: 0;
    padding-bottom: 4px;
  }

  .phase__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 2px;
    border-radius: 50%;
    border: 1px solid rgb(43 37 33 / 0.2);
    font-size: 11px;
    color: var(--vana-mute);
  }

  .phase[data-state='now'] .phase__num {
    border-color: var(--vana-terracotta);
    background: var(--vana-terracotta);
    color: var(--vana-paper);
  }

  .phase__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .phase__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .phase[data-state='next'] .phase__name {
    color: var(--vana-ink-soft);
  }

  .phase__weeks {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vana-mute);
  }

  .phase__desc {
    margin: 6px 0 0;
    max-width: 520px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--vana-mute);
  }

  .phase__bar {
    display: block;
    height: 4px;
    margin-top: 12px;
    border-radius: 2px;
    background: rgb(43 37 33 / 0.08);
    overflow: hidden;
  }

  .phase__fill {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--vana-terracotta);
  }

  /* 04 journal */

  .journal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    gap: 32px;
    align-items: start;
    margin-top: 8px;
  }

  .journal__intro {
    margin-top: 20px;
  }

  .journal__card {
    margin-top: 28px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--vana-card);
    border: 1px solid var(--vana-line);
    box-shadow: 0 18px 40px -28px rgb(43 37 33 / 0.35);
  }

  .journal__greeting {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .moods {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
  }

  .mood {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .mood__glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--vana-paper);
    border: 1px solid var(--vana-line);
    font-size: 18px;
    line-height: 1;
  }

  .mood__label {
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--vana-mute);
  }

  .prompt {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 22px;
    padding: 18px;
    border-radius: var(--radius-md);
    background: var(--vana-paper);
    border: 1px solid rgb(43 37 33 / 0.06);
  }

  .prompt__kind {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vana-terracotta);
  }

  .prompt__text {
    font-size: 17px;
    line-height: 1.4;
    font-style: italic;
  }

  .prompt__field {
    padding-top: 12px;
    border-top: 1px solid rgb(43 37 33 / 0.08);
    font-size: 14px;
    color: var(--vana-mute);
  }

  .journal__shot {
    margin: 20px 0 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--vana-cream);
  }

  .journal__shot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
  }

  /* 05 brand */

  .brand {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 140px;
    gap: 12px;
    margin-top: 36px;
  }

  .brand__tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .brand__tile--hero {
    grid-column: span 3;
    grid-row: span 2;
  }

  .brand__tile--wide {
    grid-column: span 3;
  }

  .brand__tile--swatch {
    grid-column: span 1;
  }

  .brand__tile--slot {
    grid-column: span 2;
    background: var(--vana-card);
    border: 1px solid var(--vana-line);
  }

  .brand__tile--terracotta {
    background: var(--vana-terracotta);
  }

  .brand__tile--paper {
    background: var(--vana-card);
    border: 1px solid var(--vana-line);
  }

  /* The logomark slot: a stripe box on the terracotta, sized to the tile. */
  .brand :global(.brand__slot) {
    width: 44%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: rgb(244 239 232 / 0.16);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(244 239 232 / 0.16) 0,
      rgb(244 239 232 / 0.16) 9px,
      transparent 9px,
      transparent 18px
    );
  }

  .brand :global(.brand__slot .placeholder__label) {
    color: rgb(244 239 232 / 0.85);
    background: rgb(43 37 33 / 0.25);
  }

  /* The wordmark as a stand-in, in the site's serif-less display face until
     Vana's own serif is chosen. */
  .brand__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--vana-ink);
  }

  .brand__tag {
    padding: 5px 12px;
    border-radius: 4px;
    color: rgb(43 37 33 / 0.5);
    text-align: center;
  }

  .brand__tag--on-dark {
    color: rgb(244 239 232 / 0.85);
    background: rgb(43 37 33 / 0.3);
  }

  .brand__tag--on-light {
    color: rgb(43 37 33 / 0.55);
    background: rgb(43 37 33 / 0.06);
  }

  .brand__tag--corner {
    position: absolute;
    left: 12px;
    bottom: 12px;
  }

  /* 06 design system — an ink island inside the warm story. It re-declares
     the dark tokens on itself, in both colour schemes, so everything inside
     reads as the site's ink without a single one-off colour. */

  .system {
    --color-background: var(--ink-950);
    --color-background-secondary: var(--ink-900);
    --color-foreground: var(--ice-100);
    --color-foreground-muted: var(--ice-500);
    --color-border: var(--border-invert);
    --dim: var(--ink-500);
    padding: 40px;
    margin: 0 -40px;
    border-radius: var(--radius-xl);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .system .ch__intro {
    color: var(--ice-400);
  }

  .type {
    margin-top: 32px;
    border-top: 1px solid rgb(238 242 244 / 0.12);
  }

  .type__row {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid rgb(238 242 244 / 0.12);
  }

  .type__role {
    color: var(--dim);
  }

  .type__sample[data-role='display'] {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: min(3.6vw, 44px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .type__sample[data-role='text'] {
    font-size: 17px;
    color: var(--ice-400);
  }

  .type__face {
    font-size: 13px;
    color: var(--dim);
    white-space: nowrap;
  }

  .components {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
    margin-top: 28px;
  }

  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 8px;
    border-radius: var(--radius-md);
    background: var(--ink-900);
    border: 1px solid rgb(238 242 244 / 0.1);
    text-align: center;
  }

  .tile__tag {
    font-size: 11px;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.5);
  }

  /* 07 under the hood */

  .story :global(.hood__shot) {
    margin-top: 32px;
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-lg);
    border: 1px solid var(--vana-line);
  }

  .hood__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 28px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--vana-ink-soft);
  }

  .hood__cap {
    padding-top: 12px;
    border-top: var(--hairline);
  }

  .hood__cap strong {
    display: block;
    font-weight: 600;
    color: var(--vana-ink);
  }

  /* --- where it stands ----------------------------------------------------- */

  .status {
    padding-block: 48px 8px;
  }

  .status::before {
    content: '';
    display: block;
    border-top: var(--hairline);
    margin-bottom: 40px;
  }

  .milestones {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
  }

  .milestone {
    position: relative;
    padding-top: 18px;
  }

  /* One line runs behind all four dots. */
  .milestone::before {
    content: '';
    position: absolute;
    top: 5px;
    left: 0;
    right: -24px;
    height: 1px;
    background: var(--vana-line);
  }

  .milestone:last-child::before {
    right: 0;
  }

  .milestone__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--vana-paper);
    border: 1.5px solid rgb(43 37 33 / 0.3);
  }

  .milestone[data-state='done'] .milestone__dot {
    background: var(--vana-sage);
    border-color: var(--vana-sage);
  }

  .milestone[data-state='now'] .milestone__dot {
    background: var(--vana-terracotta);
    border-color: var(--vana-terracotta);
    box-shadow: 0 0 0 4px rgb(200 98 60 / 0.18);
  }

  .milestone__label {
    display: block;
    font-size: 15px;
    font-weight: 500;
  }

  .milestone[data-state='next'] .milestone__label {
    color: var(--vana-ink-soft);
  }

  .milestone__when {
    display: block;
    margin-top: 6px;
    color: var(--dim);
  }

  /* --- stack ------------------------------------------------------------- */

  .stack {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 64px;
    padding-block: 48px 96px;
  }

  .stack::before {
    content: '';
    grid-column: 1 / -1;
    border-top: var(--hairline);
    margin-bottom: -16px;
  }

  .stack__groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--vana-ink-soft);
  }

  .stack__label {
    margin-bottom: 8px;
    color: var(--vana-ink);
  }

  /* --- next project — mirrors the door on /work/[...slug] ----------------- */

  .nextup {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 52svh;
    overflow: hidden;
    border-top: var(--hairline);
    background: var(--ink-950);
    isolation: isolate;
  }

  .nextup__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: grayscale(1);
    transition:
      transform 0.9s var(--ease-sw),
      opacity 0.5s ease,
      filter 0.5s ease;
  }

  .nextup:hover .nextup__img,
  .nextup:focus-visible .nextup__img {
    transform: scale(1.04);
    opacity: 0.75;
    filter: grayscale(0);
  }

  .nextup__body {
    padding-block: 56px;
    color: var(--ice-100);
  }

  .nextup__body .label-mono {
    opacity: 0.7;
  }

  .nextup__title {
    display: block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: min(8vw, 104px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  /* --- responsive --------------------------------------------------------- */

  @media (max-width: 1000px) {
    .ledger,
    .stack {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ledger__index {
      position: static;
    }

    .ledger__title {
      font-size: 44px;
    }

    .ledger__body {
      gap: 72px;
    }

    .rituals {
      grid-template-columns: 1fr;
    }

    .journal {
      grid-template-columns: 1fr;
    }

    .journal__shot {
      aspect-ratio: 16 / 11;
    }

    .system {
      margin: 0;
      padding: 28px;
    }

    .components {
      grid-template-columns: repeat(3, 1fr);
    }

    .hood__grid {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 120px;
    }

    .brand__tile--hero {
      grid-column: span 3;
    }

    .brand__tile--slot {
      grid-column: span 1;
    }
  }

  @media (max-width: 800px) {
    .hero {
      min-height: 80svh;
    }

    .hero__img {
      object-position: 55% 50%;
    }

    .hero__body {
      padding-top: 120px;
    }

    .hero__foot {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .hero__intro {
      font-size: 17px;
    }

    .hero__scroll {
      justify-content: flex-start;
    }

    .stats {
      grid-template-columns: 1fr 1fr;
    }

    .stats__item {
      padding: 24px 16px 24px 0;
    }

    .stats__item:nth-child(2n) {
      padding-left: 16px;
      border-right: 0;
    }

    .stats__item:nth-child(-n + 2) {
      border-bottom: var(--hairline);
    }

    .stats__value {
      font-size: 40px;
    }

    .product {
      padding-top: 64px;
    }

