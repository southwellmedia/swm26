---
/**
 * Reap Capital — client story
 * URL: /work/reap-capital
 *
 * Ported from the Claude Design prototype (Reap Capital Case Study B.dc.html).
 *
 * The first hand-built work page. The generic /work/[...slug] template skips
 * any project whose frontmatter sets `story: true`, and this file owns the URL
 * instead. It keeps the site's Nav, Cta and Footer; what changes is that the
 * whole story sits on its own paper — the site's ice with a breath of Reap's
 * forest in it — and the next-project door drops to ink to hand you on.
 * The client's own colours stay on the brand tiles.
 *
 * Content lives in @/data/reap-capital.ts. Every figure there is the
 * prototype's draft copy and needs confirming with Reap.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '@/layouts/SiteLayout.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import FilmPlayer from '@/components/site/FilmPlayer.astro';
import Cta from '@/components/sections/Cta.astro';
import {
  hero,
  stats,
  flagship,
  chapters,
  properties,
  films,
  lucidos,
  posts,
  stack,
} from '@/data/reap-capital';
import feature from '@/assets/work/reap-capital/feature.webp';
import cover from '@/assets/work/reap-capital/cover.webp';
import filmPoster from '@/assets/work/reap-capital/film-pref-equity.webp';

// Same ordering as the generic template, so "next" agrees with the grid.
const projects = (
  await getCollection(
    'work',
    ({ data }) => (import.meta.env.PROD ? data.draft !== true : true) && !data.parent
  )
).sort((a, b) => a.data.order - b.data.order);

const index = projects.findIndex((project) => project.id === 'reap-capital');
if (index === -1) throw new Error('reap-capital is missing from src/content/work');

// The section plays the first film and lists any others under it.
const [reel, ...moreFilms] = films;

const project = projects[index];
const next = projects[(index + 1) % projects.length];
const nextImage = next.data.feature ?? next.data.cover;
---

<SiteLayout
  title={project.data.title}
  description={project.data.description}
  image={cover.src}
  imageAlt={project.data.coverAlt ?? project.data.title}
  navContext={project.data.client ?? project.data.title}
>
  <article class="story">
    {/* --- hero: full-bleed, the feature photograph made safe for type ------ */}
    <header class="hero">
      <Image
        src={feature}
        alt=""
        layout="none"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        class="hero__img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__body shell">
        <p class="hero__eyebrow label-mono">
          {hero.eyebrow.map((item) => <span>{item}</span>)}
        </p>
        <h1 class="display-hero m-0">
          the whole <em>operation,</em><br />one studio.
        </h1>
        <div class="hero__foot">
          <p class="hero__intro">{hero.intro}</p>
          <div class="hero__scroll label-mono" aria-hidden="true">
            <span>scroll</span>
            <span class="hero__scroll-line"></span>
          </div>
        </div>
      </div>
    </header>

    {/* --- results ------------------------------------------------------- */}
    <section class="shell" aria-label="Results">
      <div class="stats" data-reveal>
        {
          stats.map((stat) => (
            <div class="stats__item">
              <div class="stats__value">{stat.value}</div>
              <div class="stats__label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    {/* --- 01 flagship --------------------------------------------------- */}
    <section class="flagship shell" aria-labelledby="flagship-title">
      <div class="flagship__head" data-reveal>
        <div>
          <p class="eyebrow label-mono">01 · THE FLAGSHIP</p>
          <h2 class="flagship__title display-section" id="flagship-title">
            reapcapital<em>.com</em>
          </h2>
        </div>
        <p class="flagship__intro">{flagship.intro}</p>
      </div>

      <div class="flagship__cover" data-reveal>
        <Image
          src={cover}
          alt="reapcapital.com on a laptop"
          layout="none"
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          class="flagship__cover-img"
        />
        <a class="pill label-mono" href={flagship.url} target="_blank" rel="noopener noreferrer">
          VISIT THE SITE ⟶
        </a>
      </div>

      <div class="flagship__shots" data-reveal>
        {flagship.shots.map((label) => <Placeholder invert label={label} class="flagship__shot" />)}
      </div>

      <div class="notes" data-reveal>
        {
          flagship.notes.map((note) => (
            <div class="notes__item">
              <span class="notes__label label-mono">{note.label}</span>
              {note.text}
            </div>
          ))
        }
      </div>
    </section>

    {/* --- the ledger: sticky index + six more workstreams ---------------- */}
    <section class="ledger shell" aria-labelledby="ledger-title">
      <aside class="ledger__index">
        <p class="eyebrow label-mono">THE LEDGER</p>
        <h2 class="ledger__title" id="ledger-title">
          six more <em>workstreams.</em>
        </h2>
        <ol class="ledger__list">
          {
            chapters.map((chapter) => (
              <li>
                <a href={`#ws-${chapter.num}`}>
                  <span class="ledger__num label-mono">{chapter.num}</span>
                  <span>{chapter.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </aside>

      <div class="ledger__body">
        {/* 02 property sites */}
        <article class="ws" id="ws-02" data-reveal>
          <p class="eyebrow label-mono">02 · PROPERTY SITES</p>
          <h3 class="ws__title">a site <em>per address.</em></h3>
          <p class="ws__intro">
            Every community gets its own brand, site and hourly availability from the property
            software. La Fortuna in North Dallas and The Landry in Arlington shipped first; both are
            built on LucidOS and neither looks like the other.
          </p>

          <div class="properties">
            {
              properties.map((property) => (
                <div class="property">
                  <div class="property__head">
                    <span class="property__name">{property.name}</span>
                    <span class="property__meta label-mono">{property.meta}</span>
                  </div>
                  <a
                    class="property__shot"
                    href={property.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Image
                      src={property.shot}
                      alt={property.shotAlt}
                      layout="none"
                      widths={[480, 720, 1080]}
                      sizes="(max-width: 800px) 100vw, 45vw"
                      class="property__shot-img"
                    />
                    <span class="property__url label-mono">
                      {property.url}
                      {property.status && <span class="property__status">{property.status}</span>}
                    </span>
                  </a>
                  <p class="property__blurb">{property.blurb}</p>
                  <div class="property__stats">
                    {property.stats.map((stat) => (
                      <div>
                        <div class="property__value">{stat.value}</div>
                        <div class="property__label">{stat.label}</div>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </article>

        {/* 03 brand */}
        <article class="ws" id="ws-03" data-reveal>
          <p class="eyebrow label-mono">03 · BRAND</p>
          <h3 class="ws__title">one origin, <em>every asset.</em></h3>
          <p class="ws__intro">
            Forest green, aged gold, a serif that reads like a prospectus. Built to hold from a
            pitch deck to a leasing office sign to a 288-unit front door.
          </p>

          <div class="brand">
            <div class="brand__tile brand__tile--forest brand__tile--hero">
              <img
                class="brand__logomark"
                src="/reap-logomark-gold.svg"
                alt="Reap Capital logomark"
                width="288"
                height="371"
                loading="lazy"
                decoding="async"
              />
              <span class="brand__tag brand__tag--on-dark brand__tag--corner label-mono"
                >logomark — gold on forest</span
              >
            </div>
            <div class="brand__tile brand__tile--paper brand__tile--wide">
              <span class="brand__tag brand__tag--on-light label-mono"
                >wordmark — Playfair Display</span
              >
            </div>
            <div class="brand__tile brand__tile--forest" aria-label="Forest green swatch"></div>
            <div class="brand__tile brand__tile--gold" aria-label="Aged gold swatch"></div>
            <div class="brand__tile brand__tile--sage" aria-label="Sage swatch"></div>
            <div class="brand__tile brand__tile--slot">
              <span class="brand__tag label-mono">signage</span>
            </div>
            <div class="brand__tile brand__tile--slot">
              <span class="brand__tag label-mono">investor deck</span>
            </div>
            <div class="brand__tile brand__tile--slot">
              <span class="brand__tag label-mono">sub-brands</span>
            </div>
          </div>
        </article>

        {/* 04 films */}
        <article class="ws" id="ws-04" data-reveal>
          <p class="eyebrow label-mono">04 · FILMS</p>
          <h3 class="ws__title">the first film, <em>no stock.</em></h3>
          <p class="ws__intro">
            The founder series opens on the question every LP asks before the deck: if this goes
            sideways, what protects my money? Shot on site, cut in-house, published to YouTube and
            dropped into the invest flow. One film live, the rest in the edit.
          </p>

          <div class="ws__film">
            <FilmPlayer
              id={reel.id}
              title={reel.title}
              kind={reel.kind}
              dur={reel.dur}
              poster={filmPoster}
            />
          </div>

          {/* Everything after the featured film. Empty until the next one ships. */}
          {
            moreFilms.length > 0 && (
              <ol class="films">
                {moreFilms.map((film) => (
                  <li class="films__row">
                    <span class="films__dur label-mono">{film.dur}</span>
                    <span>{film.title}</span>
                    <span class="films__kind">{film.kind}</span>
                  </li>
                ))}
              </ol>
            )
          }
        </article>

        {/* 05 lucidos — a light island in the dark page */}
        <article class="ws os" id="ws-05" data-reveal>
          <p class="eyebrow label-mono">05 · THE OPERATING SYSTEM</p>
          <h3 class="ws__title">lucidos, <em>tuned for reap.</em></h3>
          <p class="ws__intro">
            Our property platform already ran sites, tours and offers. For Reap we added AppFolio
            sync for hourly availability, a portfolio dashboard across communities, Spanish mirrors,
            and an offer engine that publishes one special to site, popup and inbox.
          </p>

          <Placeholder label="screenshot — LucidOS portfolio dashboard" class="os__shot" />

          <div class="os__grid">
            {
              lucidos.map((cap) => (
                <div class="os__cap">
                  <strong>{cap.title}</strong>
                  {cap.desc}
                </div>
              ))
            }
          </div>
        </article>

        {/* 06 social */}
        <article class="ws" id="ws-06" data-reveal>
          <p class="eyebrow label-mono">06 · SOCIAL</p>
          <h3 class="ws__title">the feed, <em>managed.</em></h3>
          <p class="ws__intro">
            Three accounts, a monthly calendar, one rule: every post comes from a real property, a
            real deal or a real person. 312 posts, 4.1× LinkedIn growth.
          </p>

          <div class="posts">
            {
              posts.map((post) => (
                <div class="tile">
                  <span class="tile__tag label-mono">{post}</span>
                </div>
              ))
            }
          </div>
        </article>

        {/* 07 email */}
        <article class="ws" id="ws-07" data-reveal>
          <p class="eyebrow label-mono">07 · EMAIL</p>
          <h3 class="ws__title">two audiences, <em>one voice.</em></h3>

          <div class="email">
            <p class="ws__intro email__intro">
              Investor updates that read like the founder wrote them (he did, we edited) and
              resident campaigns that turn a leasing special into tours by Friday. 61 campaigns, 58%
              investor open rate.
            </p>
            <div class="email__shots">
              <div class="tile tile--portrait">
                <span class="tile__tag label-mono">investor update — Q2</span>
              </div>
              <div class="tile tile--portrait">
                <span class="tile__tag label-mono">six weeks free — La Fortuna</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    {/* --- stack ---------------------------------------------------------- */}
    <section class="stack shell" aria-label="Stack and tools" data-reveal>
      <p class="eyebrow label-mono">STACK &amp; TOOLS</p>
      <div class="stack__groups">
        {
          stack.map((group) => (
            <div>
              <div class="stack__label label-mono">{group.label}</div>
              {group.items.join(' · ')}
            </div>
          ))
        }
      </div>
    </section>

    {/* --- next project: the same full-bleed door the template uses -------- */}
    <a class="nextup" href={'/work/' + next.id} data-card>
      {
        nextImage && (
          <Image
            src={nextImage}
            alt=""
            layout="none"
            widths={[768, 1280, 1920]}
            sizes="100vw"
            class="nextup__img"
          />
        )
      }
      <div class="nextup__body shell">
        <span class="label-mono">NEXT PROJECT</span>
        <span class="nextup__title">{next.data.title}</span>
      </div>
    </a>
  </article>

  <Cta />
</SiteLayout>

<style>
  /* The story sits on light paper like the other case studies, tinted a
     breath toward Reap's forest — the same move Vana makes with its warm
     paper. The palette is declared once here and the Tailwind tokens
     remapped to it, so PillButton, .label-mono and anything else that reads
     a token follows on its own. --dim is the muted grey; --story-raised is
     the panel tone a step up from the ground. */
  .story {
    --reap-paper: #eef1ea;
    --reap-cream: #e3e8dd;
    --reap-card: #f7f9f4;
    --reap-ink: #1c231a;
    --reap-ink-soft: #46503f;
    --reap-mute: #6e7867;
    --reap-line: rgb(28 35 26 / 0.12);

    --story-bg: var(--reap-paper);
    --story-raised: var(--reap-card);
    --color-background: var(--story-bg);
    --color-background-secondary: var(--reap-cream);
    --color-foreground: var(--reap-ink);
    --color-foreground-secondary: var(--reap-ink-soft);
    --color-foreground-muted: var(--reap-mute);
    --color-border: var(--reap-line);
    --color-border-strong: rgb(28 35 26 / 0.24);
    --color-primary: var(--reap-ink);
    --color-primary-foreground: var(--reap-paper);
    --color-ring: var(--reap-ink);
    --dim: var(--reap-mute);
    --hairline: 1px solid var(--reap-line);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  /* The bar frosts to the page ground once scrolled; on this page the ground
     is Reap's paper, not ice. Scoped to the page file, so nothing else sees
     it — and hairline follows, so the bar's shadow matches the story's. */
  :global(#sw-nav.is-scrolled) {
    --color-background: #eef1ea;
    --color-border: rgb(28 35 26 / 0.12);
  }

  /* The lighter second half of every headline — same move as the site's
     display <em>, read off the same tokens. */
  .story em {
    font-style: var(--display-em-style);
    font-weight: var(--display-em-weight);
    font-stretch: var(--display-em-stretch);
    letter-spacing: var(--display-em-tracking);
  }

  .eyebrow {
    margin: 0;
    color: var(--dim);
  }

  .pill {
    padding: 14px 20px;
    border-radius: var(--radius-full);
    background: var(--reap-ink);
    color: var(--reap-paper);
  }

  /* --- hero -------------------------------------------------------------- */

  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 92svh;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.5;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Two washes, as on Vana: paper rising from the foot so the story picks
       up where the photograph leaves off, and paper pooling in from the
       left so the headline sits on near-solid ground. */
    background:
      linear-gradient(
        180deg,
        rgb(238 241 234 / 0.15) 0%,
        rgb(238 241 234 / 0) 30%,
        rgb(238 241 234 / 0.7) 62%,
        var(--story-bg) 100%
      ),
      linear-gradient(
        100deg,
        rgb(238 241 234 / 0.9) 0%,
        rgb(238 241 234 / 0.75) 38%,
        rgb(238 241 234 / 0) 68%
      );
  }

  .hero__body {
    padding-block: 150px 64px;
    animation: sw-rise 0.9s var(--ease-sw) both;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0 0 28px;
    color: var(--color-foreground-muted);
  }

  .hero__foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
    margin-top: 40px;
  }

  .hero__intro {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-foreground-secondary);
    text-wrap: pretty;
  }

  .hero__scroll {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    color: var(--color-foreground-muted);
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 36px;
    background: var(--reap-ink);
    animation: sw-scrollpulse 1.6s ease-in-out infinite;
  }

  /* --- results ----------------------------------------------------------- */

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
  }

  .stats__item {
    padding: 36px 28px 36px 24px;
    border-right: var(--hairline);
  }

  .stats__item:first-child {
    padding-left: 0;
  }

  .stats__item:last-child {
    border-right: 0;
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: min(5vw, 72px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .stats__label {
    max-width: 220px;
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-foreground-muted);
  }

  /* --- flagship ---------------------------------------------------------- */

  .flagship {
    padding-block: 96px 64px;
  }

  .flagship__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: end;
  }

  .flagship__title {
    margin: 20px 0 0;
  }

  .flagship__intro {
    margin: 0;
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
  }

  .flagship__cover {
    position: relative;
    margin-top: 56px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--story-raised);
  }

  .flagship__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flagship__cover .pill {
    position: absolute;
    right: 24px;
    bottom: 24px;
  }

  .flagship__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .flagship__shots :global(.flagship__shot) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background-color: var(--reap-card);
    border: 1px solid var(--reap-line);
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 48px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-foreground-secondary);
  }

  .notes__item {
    padding-top: 16px;
    border-top: var(--hairline);
  }

  .notes__label {
    display: block;
    margin-bottom: 10px;
    color: var(--color-foreground);
  }

  /* --- the ledger -------------------------------------------------------- */

  .ledger {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 64px;
    padding-block: 64px;
  }

  /* The hairline is inside the shell, so it lines up with the stats above. */
  .ledger::before {
    content: '';
    grid-column: 1 / -1;
    border-top: var(--hairline);
    margin-bottom: -16px;
  }

  .ledger__index {
    position: sticky;
    top: calc(var(--sw-nav-h, 76px) + 28px);
    align-self: start;
  }

  .ledger__title {
    margin: 24px 0 32px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 56px;
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .ledger__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }

  .ledger__list a {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-top: var(--hairline);
    color: var(--color-foreground-secondary);
  }

  .ledger__num {
    padding-top: 2px;
    color: var(--dim);
  }

  .ledger__body {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  .ws {
    scroll-margin-top: calc(var(--sw-nav-h, 76px) + 28px);
  }

  .ws__title {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: min(4.4vw, 64px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
  }

  .ws__intro {
    max-width: 640px;
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
  }

  /* 02 property sites */

  .properties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 36px;
  }

  .property {
    padding: 20px;
    border: 1px solid var(--reap-line);
    border-radius: var(--radius-lg);
    background: var(--story-raised);
  }

  .property__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }

  .property__name {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-case);
    font-size: 26px;
    letter-spacing: -0.03em;
  }

  .property__meta {
    font-size: 11px;
    color: var(--dim);
    text-align: right;
  }

  .property__shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--ink-800);
  }

  .property__shot-img {
    display: block;
    width: 100%;
