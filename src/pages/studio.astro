---
/**
 * Studio page
 * URL: /studio
 *
 * Replaces Velocity's demo /about. The hero lede and the four service cards
 * are drawn from material that already existed; the founder section is
 * Michael's own story. The marked section still needs real writing.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Founder from '@/components/sections/Founder.astro';
import Services from '@/components/sections/Services.astro';
import Cta from '@/components/sections/Cta.astro';
import { Image } from 'astro:assets';
import siteConfig from '@/config/site.config';
import studioPhoto from '@/assets/studio/michael-froseth.jpg';
---

<SiteLayout title="Studio" description={siteConfig.description} includeOrgSchema>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      title="Studio"
      blurb="A Dallas studio where the people designing the work are the people building it."
    />
  </header>

  <div class="shell mt-16 max-[800px]:mt-10">
    <Image
      src={studioPhoto}
      alt="Michael Froseth, founder of Southwell Media"
      layout="none"
      widths={[768, 1280, 1920]}
      sizes="(max-width: 1440px) 100vw, 1440px"
      class="h-[52vh] w-full rounded-[14px] object-cover object-top max-[800px]:h-[38vh]"
    />
  </div>

  <section class="shell mt-20 max-[800px]:mt-12" data-reveal>
    <p class="max-w-[760px] text-[clamp(1.375rem,2.4vw,2rem)] leading-[1.35] tracking-[-0.02em]">
      {siteConfig.description}
    </p>

    <dl class="border-border mt-16 grid grid-cols-3 gap-10 border-t pt-10 max-[800px]:grid-cols-1">
      <div>
        <dt class="label-mono text-foreground-muted">BASED IN</dt>
        <dd class="mt-3 ml-0 text-[17px]">{siteConfig.location}</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">WORKING</dt>
        <dd class="mt-3 ml-0 text-[17px]">With clients across the globe</dd>
      </div>
      <div>
        <dt class="label-mono text-foreground-muted">SAY HI</dt>
        <dd class="mt-3 ml-0 text-[17px]">
          <a href={'mailto:' + siteConfig.email}>{siteConfig.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  {
    /* TODO: the process still needs writing. Left out rather than filled with
      placeholder prose. */
  }

  <Services />

  <Founder />
  <Cta />
</SiteLayout>
