---
/**
 * Homepage
 * URL: /
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import WorkGrid from '@/components/sections/WorkGrid.astro';
import Services from '@/components/sections/Services.astro';
import Founder from '@/components/sections/Founder.astro';
import Cta from '@/components/sections/Cta.astro';
import siteConfig from '@/config/site.config';
---

<SiteLayout
  title="Dallas Creative Agency for Websites, Apps & Brands"
  description={siteConfig.description}
  includeOrgSchema
>
  <Hero />
  {
    /* Six lands on a row boundary: the full-width lead over two rows, then the
      first five of the pattern over three. Any of 1, 6 or 11 tiles cleanly. */
  }
  <WorkGrid count={6} />
  <Services />
  <Founder />
  <Cta />
</SiteLayout>
