---
/**
 * Contact page
 * URL: /contact
 *
 * Velocity's contact form and /api/contact endpoint, wearing the studio's
 * type. The submit handler is carried over from the stock page unchanged.
 */
import { Icon } from 'astro-icon/components';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHead from '@/components/sections/SectionHead.astro';
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import siteConfig from '@/config/site.config';

const channels = [
  { label: 'EMAIL', value: siteConfig.email, href: 'mailto:' + siteConfig.email, icon: 'mail' },
  {
    label: 'PHONE',
    value: siteConfig.phone ?? '',
    href: 'tel:' + siteConfig.phoneHref,
    icon: 'phone',
  },
  { label: 'STUDIO', value: siteConfig.location, href: undefined, icon: 'map-pin' },
];
---

<SiteLayout
  title="Contact"
  description="Start a project with Southwell Media, or just say hello."
  includeOrgSchema
>
  <header class="shell pt-[180px] max-[800px]:pt-[130px]">
    <SectionHead
      title="Contact"
      blurb="Tell us what you are building. We answer every message ourselves — no forms disappearing into a queue."
    />
  </header>

  <section class="mt-20 grid grid-cols-[1.1fr_1fr] gap-20 shell max-[900px]:mt-12 max-[900px]:grid-cols-1 max-[900px]:gap-12">
    <form id="contact-form" action="/api/contact" method="POST" class="flex flex-col gap-6">
      <Input label="Your name" name="name" type="text" required autocomplete="name" />
      <Input label="Email address" name="email" type="email" required autocomplete="email" />
      <Input label="Subject" name="subject" type="text" />
      <Textarea
        label="Message"
        name="message"
        placeholder="What are you building, and what is in the way?"
        rows={6}
        required
      />

      <!-- Honeypot field for spam protection -->
      <div class="hidden" aria-hidden="true">
        <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
      </div>

      <div id="form-message" class="hidden text-sm" role="status" aria-live="polite"></div>

      <Button
        type="submit"
        id="submit-button"
        size="lg"
        class="h-auto self-start rounded-full px-10 py-[18px] text-[17px] font-semibold"
      >
        Send message
      </Button>
    </form>

    <aside class="flex flex-col gap-10">
      {
        channels.map((channel) => (
          <div class="border-t border-border pt-6">
            <span class="channel__label label-mono text-foreground-muted">
              <Icon name={'lucide:' + channel.icon} aria-hidden="true" />
              {channel.label}
            </span>
            <p class="mt-3 mb-0 text-[clamp(1.25rem,2vw,1.75rem)] tracking-[-0.03em]">
              {channel.href ? <a href={channel.href}>{channel.value}</a> : channel.value}
            </p>
          </div>
        ))
      }
    </aside>
  </section>

  <div class="h-[140px] max-[800px]:h-[100px]"></div>
</SiteLayout>

<style>
  .channel__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .channel__label :global(svg) {
    width: 14px;
    height: 14px;
    stroke-width: 1.75;
  }
</style>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const button = document.getElementById('submit-button') as HTMLButtonElement | null;
    const message = document.getElementById('form-message') as HTMLDivElement | null;

    if (!form || !button || !message) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      button.disabled = true;
      button.textContent = 'Sending...';
      message.classList.add('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          message.textContent = 'Message sent. We will get back to you shortly.';
          message.className = 'text-sm text-success';
          form.reset();
        } else {
          const errors = data.errors
            ? Object.values(data.errors).flat().join(', ')
            : 'Something went wrong';
          message.textContent = errors;
          message.className = 'text-sm text-destructive';
        }
      } catch {
        message.textContent = 'Failed to send message. Please try again later.';
        message.className = 'text-sm text-destructive';
      } finally {
        button.disabled = false;
        button.textContent = 'Send message';
        message.classList.remove('hidden');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
