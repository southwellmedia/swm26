---
/**
 * BeforeAfter
 *
 * A before/after reveal: the "after" layer sits on top and is clipped to a
 * width the range input controls. Ported from the Reap Capital case study
 * prototype.
 *
 * No images yet, so both layers are flat colour with a caption — the same
 * contract as Placeholder: pass `before` / `after` and they render, omit them
 * and the slots stay placeholders. The slider works either way. Without JS the
 * input is inert and the reveal sits at its initial width, which is still a
 * readable side-by-side.
 *
 * Built for an ink surface; the colours are the dark-band primitives.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Caption on the revealed layer, e.g. the new site's URL. */
  afterLabel: string;
  beforeLabel?: string;
  before?: ImageMetadata;
  after?: ImageMetadata;
  /** Initial reveal, 0–100. */
  reveal?: number;
  alt?: string;
}

const { afterLabel, beforeLabel = 'BEFORE', before, after, reveal = 50, alt = '' } = Astro.props;
---

<div class="compare" data-compare style={`--reveal: ${reveal}%`}>
  <div class="compare__stage">
    <div class="compare__before">
      {
        before && (
          <Image
            src={before}
            alt={alt}
            layout="none"
            widths={[640, 960, 1400]}
            sizes="(max-width: 800px) 100vw, 50vw"
          />
        )
      }
      <span class="compare__tag compare__tag--before">{beforeLabel}</span>
    </div>
    <div class="compare__after">
      {
        after && (
          <Image
            src={after}
            alt=""
            layout="none"
            widths={[640, 960, 1400]}
            sizes="(max-width: 800px) 100vw, 50vw"
          />
        )
      }
      <span class="compare__tag compare__tag--after">
        AFTER<span class="compare__tag-url"> — {afterLabel}</span>
      </span>
    </div>
  </div>
  <input
    class="compare__range"
    type="range"
    min="0"
    max="100"
    value={reveal}
    aria-label={`Reveal the redesign of ${afterLabel}`}
    data-compare-range
  />
</div>

<style>
  .compare {
    user-select: none;
  }

  .compare__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--ink-800);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(238 242 244 / 0.05) 0,
      rgb(238 242 244 / 0.05) 9px,
      transparent 9px,
      transparent 18px
    );
  }

  .compare__before,
  .compare__after {
    position: absolute;
    inset: 0;
  }

  /* Clipped to the reveal, but the image inside keeps the stage's full width
     so the two layers line up pixel for pixel. */
  .compare__after {
    width: var(--reveal);
    overflow: hidden;
    /* Reap's forest green — the "after" is their brand, not ours. */
    background: #394334;
    border-right: 2px solid var(--ice-100);
  }

  .compare__after :global(img),
  .compare__before :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .compare__after :global(img) {
    /* The clipped layer's box shrinks with --reveal, so the image is sized
       from the stage instead: 100% of the stage, not of this box. */
    width: calc(100% / (var(--reveal-fraction, 1)));
  }

  .compare__tag {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 5px 10px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .compare__tag--before {
    right: 12px;
    bottom: 12px;
    color: rgb(255 255 255 / 0.5);
    background: rgb(255 255 255 / 0.08);
  }

  .compare__tag--after {
    left: 12px;
    top: 12px;
    color: rgb(238 242 244 / 0.8);
    background: rgb(12 16 22 / 0.5);
  }

  /* The domain is the first thing the reveal edge clips on a phone. */
  @media (max-width: 800px) {
    .compare__tag-url {
      display: none;
    }
  }

  .compare__range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 24px;
    margin: 10px 0 0;
    background: transparent;
    cursor: ew-resize;
  }

  .compare__range::-webkit-slider-runnable-track {
    height: 1px;
    background: rgb(238 242 244 / 0.3);
  }

  .compare__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-radius: 50%;
    background: var(--ice-100);
    border: 3px solid var(--ink-950);
  }

  .compare__range::-moz-range-track {
    height: 1px;
    background: rgb(238 242 244 / 0.3);
  }

  .compare__range::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ice-100);
    border: 3px solid var(--ink-950);
  }

  .compare__range:focus-visible {
    outline: 2px solid var(--ice-100);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>

<script>
  // One listener per slider; `input` fires continuously while dragging.
  // Re-run after a view-transition swap, since the DOM is replaced.
  function initCompare() {
    for (const compare of document.querySelectorAll<HTMLElement>('[data-compare]')) {
      const range = compare.querySelector<HTMLInputElement>('[data-compare-range]');
      if (!range || range.dataset.ready) continue;
      range.dataset.ready = '';

      const apply = () => {
        const value = Number(range.value);
        compare.style.setProperty('--reveal', `${value}%`);
        // Keeps the after-image sized to the stage while its box shrinks.
        compare.style.setProperty('--reveal-fraction', String(Math.max(value, 1) / 100));
      };

      apply();
      range.addEventListener('input', apply);
    }
  }

  initCompare();
  document.addEventListener('astro:after-swap', initCompare);
</script>
