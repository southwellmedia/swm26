---
/**
 * Nav
 *
 * A wordmark and a menu control, nothing else. Transparent over the hero,
 * frosted-solid once you scroll past it.
 *
 * The wordmark unfurls on hover: "southwell media" is already hiding inside
 * "sw" — s-outh-w-ell — so the missing letters grow out from between the two
 * visible ones rather than a second label fading in beside them.
 *
 * The menu control is two rules of unequal length that level up on hover and
 * cross into an X when the overlay opens. A labelled "Menu ———" was doing the
 * same job with more furniture.
 */
import { Icon } from 'astro-icon/components';
import { getNavItems } from '@/config/nav.config';
import siteConfig from '@/config/site.config';
import ThemeToggle from '@/components/layout/ThemeToggle.astro';

interface Props {
  /**
   * Whose page this is — a client name, set after the wordmark's slash so the
   * nav reads "sw/ cirries". Only the work case studies pass one.
   */
  context?: string;
  /**
   * The bar is sitting over a dark full-bleed image rather than the page
   * ground, so the ink wordmark would disappear into it until the bar frosts
   * on scroll.
   */
  overMedia?: boolean;
  /**
   * The page itself is on ink (a client story), so once the bar frosts it
   * must frost to ink rather than the page ground, in either colour scheme.
   */
  tone?: 'dark';
}

const { context, overMedia = false, tone } = Astro.props;

const items = getNavItems();
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header
  class="sw-nav"
  id="sw-nav"
  data-menu-open="false"
  data-over-media={overMedia ? '' : undefined}
  data-tone={tone}
>
  <div class="sw-nav__inner shell">
    {
      /* The context sits outside the anchor deliberately: the wordmark goes
        home, and a client name that quietly did the same would be a trap. */
    }
    <div class="sw-nav__brand">
      <a href="/" class="mark" aria-label={siteConfig.name + ' — home'}>
        <span class="mark__seen">s</span>
        <span class="mark__grow"><span class="mark__hidden">outh</span></span>
        <span class="mark__seen">w</span>
        <span class="mark__grow"><span class="mark__hidden">ell media</span></span>
        <span class="mark__seen mark__slash">/</span>
      </a>

      {context && <span class="mark__context">{context}</span>}
    </div>

    <div class="sw-nav__actions">
      {
        /* The studio's number, one tap away on every page. The digits drop
          on narrow screens and the handset stays. */
      }
      <a class="sw-nav__phone" href={'tel:' + siteConfig.phoneHref}>
        <Icon name="fa6-solid:phone" aria-hidden="true" />
        <span class="sw-nav__phone-number label-mono">{siteConfig.phone}</span>
        <span class="sr-only">Call {siteConfig.name}</span>
      </a>

      <button
        class="burger"
        id="sw-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="sw-menu"
      >
        <span class="burger__lines" aria-hidden="true">
          <span class="burger__line"></span>
          <span class="burger__line"></span>
        </span>
        <span class="sr-only" id="sw-nav-toggle-label">Open menu</span>
      </button>
    </div>
  </div>
</header>

{
  /* The strip of page left showing under the sheet. Dimmed a touch, and a
    click on it closes the menu — it is a button, so it says so. */
}
<button
  class="sw-menu__scrim"
  id="sw-menu-scrim"
  type="button"
  tabindex="-1"
  aria-label="Close menu"
  inert></button>

{
  /* The menu is a card of ink poured from the top: as tall as what is in
    it, capped so the page keeps showing beneath, with a liquid underside
    drawn on the canvas strip (src/scripts/menu-edge.ts). data-edge switches
    to the stylesheet's still scalloped edge when the engine cannot run. */
}
<div class="sw-menu invert-section" id="sw-menu" data-state="closed" data-edge="live" inert>
  <div class="sw-menu__inner shell">
    <nav class="sw-menu__nav" aria-label="Main">
      <ul class="sw-menu__list">
        {
          items.map((item, i) => (
            <li class="sw-menu__item">
              <a
                class="sw-menu__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="sw-menu__index label-mono" aria-hidden="true">
                  0{i + 1}
                </span>
                <span class="sw-menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /* The quiet column: what the studio is, how to reach it, where it is.
        Body and mono sizes against the display type on the left. */
    }
    <aside class="sw-menu__aside">
      <p class="sw-menu__blurb">
        A Dallas creative agency building original websites, apps and brands. No templates, no
        themes.
      </p>
      <div class="sw-menu__contact">
        <a href={'mailto:' + siteConfig.email}>{siteConfig.email}</a>
        <a href={'tel:' + siteConfig.phoneHref}>{siteConfig.phone}</a>
      </div>
      <div class="sw-menu__meta">
        <span class="label-mono">{siteConfig.location}</span>
        <ThemeToggle class="sw-menu__theme" />
      </div>
    </aside>
  </div>

  <canvas class="sw-menu__edge" id="sw-menu-edge" aria-hidden="true"></canvas>
</div>

<style>
  /* The bar spans the viewport so the frosted background reaches both edges;
     its contents are held to the same shell as the page. */
  .sw-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding-block: 22px;
    /* No will-change here: a fixed element already composites on its own
       layer, and the bar never animates transform. Pinning a second hint just
       kept a full-width layer resident for nothing. */
    color: var(--color-foreground);
    background: transparent;
    animation: sw-fadein 1s 0.9s both;
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease,
      padding 0.4s ease,
      color 0.3s ease;
  }

  .sw-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Over a dark hero the bar borrows the ice palette — the burger draws from
     currentColor, so one declaration carries both. Once .is-scrolled frosts the
     bar with the page ground, the normal colours are correct again. */
  .sw-nav[data-over-media]:not(.is-scrolled) {
    color: var(--ice-100);
  }

  .sw-nav[data-over-media]:not(.is-scrolled) .mark__context {
    color: var(--nav-context-on-media);
  }

  /* A page on ink: the bar reads its colours from the story, not the page
     ground. The variables are remapped on the bar itself so the existing
     rules below need no second copy. */
  .sw-nav[data-tone='dark'] {
    --color-background: var(--ink-950);
    --color-foreground: var(--ice-100);
    --color-border: var(--border-invert);
    --nav-context: var(--nav-context-on-media);
  }

  .sw-nav.is-scrolled {
    padding-block: 14px;
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-border);
  }

  /* Over the open overlay the bar goes transparent again and flips to ice. */
  .sw-nav[data-menu-open='true'] {
    background: transparent;
    box-shadow: none;
    color: var(--on-invert);
  }

  /* --- wordmark --------------------------------------------------------- */

  .sw-nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    min-width: 0;
  }

  .mark {
    display: inline-flex;
    flex: none;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* Whose page this is. Lighter than the wordmark and in the one accent the
     site allows itself, so it reads as a second voice rather than more brand.
     Retune --nav-context in themes/southwell.css. */
  .mark__context {
    /* If anything has to give, it is the client name, never the wordmark. */
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: var(--display-case);
    color: var(--nav-context);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* 0fr to 1fr on a grid column animates to the content's own width — the
     letters genuinely unroll rather than sliding a fixed distance. */
  .mark__grow {
    display: inline-grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 0.55s var(--ease-sw);
  }

  .mark__hidden {
    overflow: hidden;
    min-width: 0;
    opacity: 0;
    transition: opacity 0.35s ease 0.05s;
  }

  .mark:hover .mark__grow,
  .mark:focus-visible .mark__grow {
    grid-template-columns: 1fr;
  }

  .mark:hover .mark__hidden,
  .mark:focus-visible .mark__hidden {
    opacity: 1;
  }

  .mark__slash {
    /* The slash leads the reveal slightly, so it reads as being pushed along
       by the letters rather than sitting still while they appear. */
    transition: transform 0.55s var(--ease-sw);
  }

  .mark:hover .mark__slash {
    transform: translateX(1px);
  }

  /* --- menu control ----------------------------------------------------- */

  .sw-nav__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* The number: a mono label with the handset, in the bar's current colour
     so it follows the bar over media and into the open overlay. */
  .sw-nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--radius-full);
    color: inherit;
    text-decoration: none;
    transition: background 0.3s ease;
  }

  .sw-nav__phone:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .sw-nav__phone :global(svg) {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .sw-nav__phone-number {
    color: inherit;
    letter-spacing: 0.04em;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .burger:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .burger__lines {
    position: relative;
    display: block;
    width: 24px;
    height: 12px;
  }

  .burger__line {
    position: absolute;
    right: 0;
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition:
      width 0.35s var(--ease-sw),
      transform 0.35s var(--ease-sw),
      top 0.25s var(--ease-sw);
  }

  /* Unequal at rest; they level up on hover. */
  .burger__line:first-child {
    top: 2px;
    width: 24px;
  }

  .burger__line:last-child {
    top: 9px;
    width: 15px;
  }

  .burger:hover .burger__line:last-child {
    width: 24px;
  }

  /* Open: both centre, then cross. */
  .sw-nav[data-menu-open='true'] .burger__line {
    top: 5px;
    width: 24px;
  }

  .sw-nav[data-menu-open='true'] .burger__line:first-child {
    transform: rotate(45deg);
  }

  .sw-nav[data-menu-open='true'] .burger__line:last-child {
    transform: rotate(-45deg);
  }

  /* --- the menu ------------------------------------------------------- */

  /* A card of ink poured from the top. As tall as what is in it, capped so
     the page keeps showing beneath; no fade — ink arrives, it does not
     appear. --edge-overlap is how far the liquid edge's canvas reaches back
     up over the sheet so the join is under ink. */
  .sw-menu {
    --edge-overlap: 44px;
    --edge-height: 200px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 55;
    max-height: 58vh;
    max-height: 58svh;
    padding: calc(var(--sw-nav-h, 84px) + 16px) 0 44px;
    background: var(--color-background);
    color: var(--color-foreground);
    visibility: hidden;
    transform: translateY(-104%);
    transition:
      transform 0.6s cubic-bezier(0.4, 0.7, 0.15, 1),
      visibility 0s 0.6s;
  }

  .sw-menu[data-state='open'] {
    visibility: visible;
    transform: none;
    transition:
      transform 0.7s cubic-bezier(0.2, 0.9, 0.2, 1),
      visibility 0s;
  }

  /* The words come up once, together, just behind the sheet. */
  .sw-menu__inner {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 320px);
    align-items: end;
    gap: 48px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .sw-menu[data-state='open'] .sw-menu__inner {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease 0.28s,
      transform 0.6s var(--ease-sw) 0.28s;
  }

  .sw-menu__list {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sw-menu__link {
    display: grid;
    grid-template-columns: 36px auto;
    align-items: baseline;
    gap: 14px;
    padding: 4px 0;
    text-decoration: none;
    color: inherit;
  }

  .sw-menu__index {
    color: var(--color-foreground-muted);
  }

  .sw-menu__label {
    /* Only as wide as the word: the hover drip is placed under its centre. */
    justify-self: start;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(40px, 4.4vw, 56px);
    line-height: 1.02;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    transition:
      font-weight 0.35s var(--ease-sw),
      font-stretch 0.35s var(--ease-sw),
      letter-spacing 0.35s var(--ease-sw),
      color 0.3s ease;
  }

  /* Hover and the current page narrow and lighten the word — the emphasis
     move the headlines use, not an underline and not an arrow. */
  .sw-menu__link:hover .sw-menu__label,
  .sw-menu__link:focus-visible .sw-menu__label,
  .sw-menu__link[aria-current='page'] .sw-menu__label {
    font-style: var(--display-em-style);
    font-weight: var(--display-em-weight);
    font-stretch: var(--display-em-stretch);
    letter-spacing: var(--display-em-tracking);
  }

  .sw-menu__link[aria-current='page'] .sw-menu__index {
    color: var(--color-foreground);
  }

  .sw-menu__aside {
    display: grid;
    gap: 16px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-foreground-secondary);
  }

  .sw-menu__blurb {
    margin: 0;
    max-width: 30ch;
  }

  .sw-menu__contact {
    display: grid;
    gap: 4px;
  }

  .sw-menu__contact a {
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    width: fit-content;
    transition: border-color 0.3s ease;
  }

  .sw-menu__contact a:hover {
    border-color: currentColor;
  }

  .sw-menu__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--color-foreground-muted);
  }

  .sw-menu__edge {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - var(--edge-overlap));
    width: 100%;
    height: var(--edge-height);
    pointer-events: none;
  }

  /* Without the engine: a still, gently scalloped edge. */
  .sw-menu[data-edge='static'] .sw-menu__edge {
    display: none;
  }

  .sw-menu[data-edge='static']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 26px;
    background: radial-gradient(circle at 50% 0, var(--color-background) 58%, transparent 60%) 0 0 /
      64px 26px repeat-x;
  }

  .sw-menu__scrim {
    position: fixed;
    inset: 0;
    z-index: 54;
    padding: 0;
    border: 0;
    background: rgb(12 16 22 / 0.34);
    opacity: 0;
    visibility: hidden;
    cursor: pointer;
    transition:
      opacity 0.45s ease,
      visibility 0s 0.45s;
  }

  .sw-menu__scrim[data-state='open'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.6s ease 0.05s,
      visibility 0s;
  }

  @media (max-width: 700px) {
    .sw-nav__phone {
      padding: 10px;
    }

    .sw-nav__phone-number {
      display: none;
    }

    .sw-menu {
      max-height: 70vh;
      max-height: 70svh;
      padding-bottom: 36px;
    }

    .sw-menu__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .sw-menu__label {
      font-size: clamp(34px, 9.5vw, 44px);
    }
  }

  /* The unfurl is decorative; without motion the mark simply stays as sw/. */
  @media (prefers-reduced-motion: reduce) {
    .mark__grow,
    .mark__hidden,
    .mark__slash,
    .burger__line {
      transition: none;
    }
  }
</style>

<script>
  import { createMenuEdge } from '@/scripts/menu-edge';

  function initNav() {
    const nav = document.getElementById('sw-nav');
    const toggle = document.getElementById('sw-nav-toggle');
    const menu = document.getElementById('sw-menu');

    if (!nav || !toggle || !menu) return;

    const label = document.getElementById('sw-nav-toggle-label');
    const scrim = document.getElementById('sw-menu-scrim');
    const list = menu.querySelector<HTMLElement>('.sw-menu__list');
    let open = false;
    let scrolled = false;

    // The liquid underside. Reduced motion or no WebGL gets the stylesheet's
    // still edge instead.
    const edgeCanvas = document.getElementById('sw-menu-edge');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const edge =
      edgeCanvas instanceof HTMLCanvasElement && !reduced
        ? createMenuEdge({
            canvas: edgeCanvas,
            sheet: menu,
            overlap: parseFloat(getComputedStyle(menu).getPropertyValue('--edge-overlap')) || 44,
          })
        : null;
    if (!edge?.supported) menu.dataset.edge = 'static';
    let edgeStop = 0;

    /* The bar is fixed, so anything that wants to sit clear of it — the sticky
       band headings on a case study, for one — needs to know how tall it is,
       and only the browser knows that once the display font has loaded. */
    const publishHeight = () => {
      document.documentElement.style.setProperty(
        '--sw-nav-h',
        `${Math.round(nav.getBoundingClientRect().height)}px`
      );
    };
    publishHeight();
    // One measurement per frame at most, however fast resize events arrive.
    let resizeRaf = 0;
    const onResize = () => {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        publishHeight();
      });
    };
    window.addEventListener('resize', onResize, { passive: true });
    if (document.fonts?.ready) void document.fonts.ready.then(publishHeight);
    // The bar is shorter once it frosts. Measure when that transition has
    // finished rather than inside the scroll handler: reading layout and
    // writing to <html> mid-scroll forces a reflow in the same frame the
    // frost switches on.
    const onTransitionEnd = (event: TransitionEvent) => {
      if (event.target === nav && event.propertyName.startsWith('padding')) publishHeight();
    };
    nav.addEventListener('transitionend', onTransitionEnd);

    const setOpen = (next: boolean) => {
      open = next;
      nav.dataset.menuOpen = String(next);
      menu.dataset.state = next ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(next));
      if (label) label.textContent = next ? 'Close menu' : 'Open menu';

      // inert keeps the closed overlay out of the tab order and the
      // accessibility tree — visibility: hidden alone would not.
      if (next) menu.removeAttribute('inert');
      else menu.setAttribute('inert', '');
      if (scrim) {
        scrim.dataset.state = next ? 'open' : 'closed';
        if (next) scrim.removeAttribute('inert');
        else scrim.setAttribute('inert', '');
      }

      // The edge runs while the sheet is down, and for as long as it takes
      // the sheet to lift back out of view, so the drips stretch with it.
      if (edge?.supported) {
        window.clearTimeout(edgeStop);
        if (next) edge.start();
        else edgeStop = window.setTimeout(() => edge.stop(), 800);
      }

      document.documentElement.style.overflow = next ? 'hidden' : '';

      if (next) {
        const first = menu.querySelector('a');
        if (first instanceof HTMLElement) first.focus();
      }
    };

    const onScroll = () => {
      const next = window.scrollY > 60;
      if (next === scrolled) return;
      scrolled = next;
      nav.classList.toggle('is-scrolled', next);
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    };

    // The edge listens to the list (a drip forms under the hovered item) and
    // to the cursor (the ink leans toward it near the edge).
    const onListOver = (event: Event) => {
      const link = (event.target as HTMLElement | null)?.closest('.sw-menu__link');
      if (!(link instanceof HTMLElement)) return;
      const r =
        link.querySelector('.sw-menu__label')?.getBoundingClientRect() ??
        link.getBoundingClientRect();
      edge?.setHover(r.left + r.width / 2);
    };
    const onListOut = (event: Event) => {
      const to = (event as MouseEvent).relatedTarget as Node | null;
      if (list && to && list.contains(to)) return;
      edge?.setHover(null);
    };
    const onPointerMove = (event: PointerEvent) => {
      if (open) edge?.setPointer(event.clientX, event.clientY);
    };
    const onPointerLeave = () => edge?.setPointer(null, null);
    const onScrim = () => setOpen(false);

    toggle.addEventListener('click', () => setOpen(!open));
    scrim?.addEventListener('click', onScrim);
    list?.addEventListener('pointerover', onListOver);
    list?.addEventListener('pointerout', onListOut);
    window.addEventListener('pointermove', onPointerMove, { passive: true });
    document.addEventListener('mouseleave', onPointerLeave);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('keydown', onKeydown);
    onScroll();

    // View transitions swap the DOM; drop the document/window listeners with
    // it so they do not stack up across navigations.
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        window.removeEventListener('pointermove', onPointerMove);
        document.removeEventListener('mouseleave', onPointerLeave);
        nav.removeEventListener('transitionend', onTransitionEnd);
        cancelAnimationFrame(resizeRaf);
        document.removeEventListener('keydown', onKeydown);
        document.documentElement.style.overflow = '';
        window.clearTimeout(edgeStop);
        edge?.destroy();
      },
      { once: true }
    );
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
