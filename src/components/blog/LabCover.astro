---
/**
 * LabCover: a Lab post's cover — the generated art (src/lib/lab.ts) with the
 * category and the cover word set over it in the site's own faces.
 *
 * `size` only scales the type: the lead story on /blog and the article hero
 * set the word large; cards set it smaller. The picture is decorative (the
 * title always sits beside it), so it carries no alt text.
 */
import { categoryOf, coverUrl, coverWord, type Post } from '@/lib/lab';

interface Props {
  post: Post;
  size?: 'card' | 'lead' | 'hero';
  /** The post's number in the Lab, oldest first. */
  number?: number;
  eager?: boolean;
  class?: string;
}

const { post, size = 'card', number, eager = false, class: className } = Astro.props;
const category = categoryOf(post);
---

<div
  class:list={['lab-cover', `lab-cover--${size}`, className]}
  style={`--lab-accent: ${category.accent}`}
>
  <img
    src={coverUrl(post)}
    alt=""
    width="1600"
    height="1000"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <span class="lab-cover__cat">{category.label}</span>
  {number !== undefined && <span class="lab-cover__num">No. {String(number).padStart(2, '0')}</span>}
  <span class="lab-cover__word" aria-hidden="true">{coverWord(post)}</span>
</div>

<style>
  .lab-cover {
    position: relative;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    background: var(--ink-950, #0c1016);
    color: var(--ice-100, #eef2f4);
    isolation: isolate;
  }
  .lab-cover--hero {
    aspect-ratio: 21 / 9;
  }

  /* A shade along the top and the bottom, so the labels and the word read
     wherever the dots happen to gather. */
  .lab-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(6 9 13 / 0.55), transparent 26%),
      linear-gradient(to top, rgb(6 9 13 / 0.6), transparent 42%);
    pointer-events: none;
  }

  .lab-cover img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-sw);
  }

  .lab-cover__cat,
  .lab-cover__num {
    position: absolute;
    top: max(16px, 4cqw);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lab-cover__cat {
    left: max(16px, 4cqw);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  /* A small lamp in the category's colour. */
  .lab-cover__cat::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lab-accent);
    box-shadow: 0 0 10px var(--lab-accent);
  }
  /* The number sits where the art is busiest, so it gets a pill of its own. */
  .lab-cover__num {
    right: max(16px, 4cqw);
    margin-top: -4px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgb(6 9 13 / 0.62);
    color: rgb(238 242 244 / 0.78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .lab-cover__word {
    position: absolute;
    left: max(16px, 4cqw);
    right: max(16px, 4cqw);
    bottom: max(12px, 3cqw);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 12cqw;
    line-height: 0.95;
    letter-spacing: var(--display-tracking);
    text-transform: lowercase;
    text-wrap: balance;
  }
  .lab-cover--lead .lab-cover__word {
    font-size: 11cqw;
  }
  .lab-cover--hero .lab-cover__word {
    font-size: 8cqw;
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-cover img {
      transition: none;
    }
  }
</style>
