---
/**
 * LabCard: one post in a grid — cover, then date and reading time, the
 * title, and two lines of the description. Used by /blog and by the related
 * posts under an article, so a post looks the same wherever it is listed.
 */
import LabCover from './LabCover.astro';
import { categoryOf, postUrl, readingTime, shortDate, type Post } from '@/lib/lab';

interface Props {
  post: Post;
  number?: number;
  /** Heading level, so the card fits the outline of the page it is on. */
  as?: 'h2' | 'h3';
}

const { post, number, as: Heading = 'h2' } = Astro.props;
---

<article class="lab-card" data-category={categoryOf(post).id}>
  <a href={postUrl(post)} class="lab-card__link">
    <LabCover post={post} number={number} />
    <p class="lab-card__meta">
      <time datetime={post.data.publishedAt.toISOString()}>{shortDate(post.data.publishedAt)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post)} min read</span>
    </p>
    <Heading class="lab-card__title">{post.data.title}</Heading>
    <p class="lab-card__desc">{post.data.description}</p>
  </a>
</article>

<style>
  .lab-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .lab-card__link:hover {
    opacity: 1;
  }
  .lab-card__link:hover :global(.lab-cover img),
  .lab-card__link:focus-visible :global(.lab-cover img) {
    transform: scale(1.04);
  }
  .lab-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }

  .lab-card__meta {
    display: flex;
    gap: 10px;
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .lab-card__title {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(22px, 1.8vw, 28px);
    line-height: 1.12;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    text-wrap: balance;
    transition: opacity 0.25s ease;
  }
  .lab-card__link:hover .lab-card__title {
    opacity: 0.65;
  }

  .lab-card__desc {
    display: -webkit-box;
    margin: 12px 0 0;
    overflow: hidden;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-foreground-secondary);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
