---
/**
 * ArticleHero: the top of a Lab post.
 *
 * The way back to the Lab, the topic in its colour with the date and the
 * reading time, the title and the standfirst, the byline with the author's
 * face, then the post's cover run wide — the same cover the post wears on
 * /blog (src/lib/lab.ts), so the card and the page are visibly one thing.
 */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import LabCover from './LabCover.astro';
import { categoryOf, readingTime, shortDate } from '@/lib/lab';

interface Props {
  /** The post's collection id, e.g. `en/astro-6-stable-release`. */
  id: string;
}

const post = await getEntry('blog', Astro.props.id);
if (!post) throw new Error(`Lab post ${Astro.props.id} not found`);
const { title, description, publishedAt, updatedAt } = post.data;
const author = await getEntry('authors', post.data.author);
const category = categoryOf(post);
---

<header class="post-hero shell">
  <a class="post-hero__back" href="/blog"><span aria-hidden="true">←</span> The Lab</a>

  <p class="post-hero__meta">
    <span class="post-hero__cat" style={`--lab-accent: ${category.accent}`}>{category.label}</span>
    <span aria-hidden="true">·</span>
    <time datetime={publishedAt.toISOString()}>{shortDate(publishedAt)}</time>
    {
      updatedAt && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            Updated <time datetime={updatedAt.toISOString()}>{shortDate(updatedAt)}</time>
          </span>
        </>
      )
    }
    <span aria-hidden="true">·</span>
    <span>{readingTime(post)} min read</span>
  </p>

  <h1 class="post-hero__title">{title}</h1>
  <p class="post-hero__desc">{description}</p>

  {
    author && (
      <p class="post-hero__byline">
        {author.data.avatar && (
          <Image
            src={author.data.avatar}
            alt=""
            width={96}
            widths={[48, 96]}
            sizes="48px"
            loading="eager"
          />
        )}
        <span>
          <strong>{author.data.name}</strong>
          <span>Founder, Southwell Media</span>
        </span>
      </p>
    )
  }

  <LabCover post={post} size="hero" class="post-hero__cover" eager />
</header>

<style>
  .post-hero {
    padding-top: clamp(120px, 11vw, 168px);
  }

  .post-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 15px;
    color: var(--color-foreground-secondary);
    text-decoration: none;
  }
  .post-hero__back:hover {
    color: var(--color-foreground);
    opacity: 1;
  }
  .post-hero__back span {
    transition: transform 0.25s var(--ease-sw);
  }
  .post-hero__back:hover span {
    transform: translateX(-4px);
  }

  .post-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 32px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .post-hero__cat {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-foreground);
  }
  .post-hero__cat::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lab-accent);
  }

  .post-hero__title {
    max-width: 18ch;
    margin: 24px 0 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(40px, 5.6vw, 88px);
    line-height: 1;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    text-wrap: balance;
  }
  .post-hero__desc {
    max-width: 640px;
    margin: 28px 0 0;
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.55;
    color: var(--color-foreground-secondary);
    text-wrap: pretty;
  }

  .post-hero__byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 36px 0 0;
  }
  .post-hero__byline :global(img) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .post-hero__byline strong,
  .post-hero__byline span span {
    display: block;
  }
  .post-hero__byline strong {
    font-size: 16px;
    font-weight: 500;
  }
  .post-hero__byline span span {
    margin-top: 2px;
    font-size: 14px;
    color: var(--color-foreground-muted);
  }

  .post-hero :global(.post-hero__cover) {
    margin-top: clamp(48px, 5vw, 72px);
  }

  @media (max-width: 800px) {
    .post-hero :global(.post-hero__cover) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
