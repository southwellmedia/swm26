---
/**
 * AboutStatement: the reel's open frame as one sentence.
 *
 * A single statement in the display face on a field of brand ink, lit word
 * by word as the page scrolls (src/scripts/reel/about.ts). The facts and the
 * way on arrive last, small, at the edges. ?tone=light sets it in ink on ice
 * instead, for comparison.
 *
 * The markup is the finished state. Without the engine (no JS, reduced
 * motion, no WebGL) that is exactly what shows.
 */
import { Image } from 'astro:assets';
import portrait from '@/assets/authors/MichaelFroseth-relight.webp';

// The sentence, as runs of words; `accent` runs are set in the signature
// colour.
const runs: Array<{ text: string; accent?: boolean }> = [
  { text: 'For twenty years I’ve learned how' },
  { text: 'design, code and business', accent: true },
  { text: 'fit together. I still build every project' },
  { text: 'myself.', accent: true },
];
---

<div class="statement" data-about-concept="statement">
  <p class="statement__line m-0" data-statement-line>
    {
      runs.map((run) =>
        run.text
          .split(' ')
          .map((word) => (
            <span class:list={['statement__w', run.accent && 'statement__w--accent']}>{word} </span>
          ))
      )
    }
  </p>

  <div class="statement__foot" data-statement-foot>
    <div class="statement__sig">
      <Image
        class="statement__avatar"
        src={portrait}
        alt=""
        width={128}
        widths={[64, 128]}
        sizes="64px"
        loading="eager"
        decoding="async"
      />
      <p class="m-0">
        <span class="statement__name">Michael Froseth</span>
        <span class="statement__role">Founder, Southwell Media</span>
      </p>
    </div>
    <p class="statement__facts label-mono m-0">
      <span>20+ years</span><span>Dallas, TX</span><span>Since 2024</span>
    </p>
    <a class="statement__link" href="/studio">More about me <span aria-hidden="true">→</span></a>
  </div>
</div>

<style>
  .statement {
    /* Brand ink, as the footer and the ink service card. The frame's own
       picture is the same token (about.ts), so the bloom lands on it. */
    --st-bg: var(--ink-950, #0c1016);
    --st-fg: var(--ice-100, #eef2f5);
    --st-muted: rgb(238 242 245 / 0.62);
    position: absolute;
    inset: 0;
    container-type: size;
    overflow: hidden;
    background: var(--st-bg);
    color: var(--st-fg);
  }
  /* Ink on ice: the page's own ground, a shade deeper so the frame reads. */
  :global(.reel[data-tone='light']) .statement {
    --st-bg: var(--ice-200, #e1e7ec);
    --st-fg: var(--ink-950, #0c1016);
    --st-muted: rgb(12 16 22 / 0.58);
  }

  .statement__line {
    position: absolute;
    left: 5cqw;
    right: 5cqw;
    top: 50%;
    translate: 0 -58%;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 5.6cqw;
    line-height: 1.02;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    text-wrap: balance;
  }
  .statement__w--accent {
    color: var(--signature-color, #ff542e);
  }

  .statement__foot {
    position: absolute;
    left: 5cqw;
    right: 5cqw;
    bottom: 4.6cqh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--st-muted);
  }

  /* Who is talking: the face, the name, the role. */
  .statement__sig {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .statement__avatar {
    flex: none;
    width: clamp(48px, 4.4cqw, 64px);
    aspect-ratio: 1;
    height: auto;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 24%;
    box-shadow: 0 0 0 1.5px var(--st-bg), 0 0 0 3px rgb(255 84 46 / 0.9);
  }
  .statement__name,
  .statement__role {
    display: block;
  }
  .statement__name {
    color: var(--st-fg);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .statement__role {
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.3;
  }
  .statement__facts {
    display: flex;
    gap: 22px;
  }
  .statement__link {
    white-space: nowrap;
    color: var(--st-fg);
    font-size: 16px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    pointer-events: auto;
  }
  .statement__link:hover {
    color: var(--signature-color, #ff542e);
  }

  /* Live, every word waits dim until the scroll reaches it. The static block
     keeps the finished sentence. */
  :global(.reel[data-reel-mode='live']) .statement__w {
    opacity: 0.14;
    transition: opacity 0.25s linear;
  }
  :global(.reel[data-reel-mode='live']) .statement__w.is-on {
    opacity: 1;
  }

  @media (max-width: 800px) {
    .statement__line {
      font-size: 9.6cqw;
      top: 44%;
    }
    .statement__foot {
      flex-wrap: wrap;
      gap: 10px 16px;
    }
    .statement__facts {
      order: 3;
      width: 100%;
      gap: 14px;
    }
  }
</style>
