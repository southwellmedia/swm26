---
/**
 * Services
 *
 * Four cards that pile up as you scroll: each sticks 20px lower than the one
 * before it, so the stack stays legible instead of the cards scrolling past
 * one another.
 *
 * Two motions on top of the stacking:
 *
 *   entrance  as a card arrives its number fades in, the two title lines
 *             rise out of their masks, then the tags and the paragraph
 *             follow — play-once, via Motion's [data-reveal] system.
 *   recede    as the next card slides up to cover it, the card underneath
 *             eases back and dims — scroll-linked, via a view timeline on
 *             the *next* card. `timeline-scope` on the section lets card N
 *             read card N+1's timeline. Browsers without it keep the static
 *             depth from translateZ and nothing else.
 */
import SectionHead from './SectionHead.astro';
import { services } from '@/config/services.config';

const last = services.length - 1;
// One named timeline per covering card (every card but the first).
const timelineScope = services
  .slice(1)
  .map((_, i) => `--svc-${i + 1}`)
  .join(', ');
---

<section class="pt-[130px] max-[800px]:pt-[90px]" style={`timeline-scope: ${timelineScope}`}>
  <div class="shell mb-14">
    <SectionHead
      title="Services"
      blurb="An unusual studio, focused on transforming your vision into a captivating digital experience."
      id="services"
    />
  </div>

  {
    services.map((service, i) => (
      <div
        class="services__slot shell"
        style={
          '--sticky-top:' +
          (90 + i * 20) +
          'px; --i:' +
          i +
          (i > 0 ? `; view-timeline-name: --svc-${i}` : '')
        }
      >
        <article
          class:list={['service', i < last && 'service--covered']}
          data-theme={service.theme}
          style={i < last ? `animation-timeline: --svc-${i + 1}` : undefined}
        >
          <div class="service__lead">
            <span class="service__num label-mono" data-reveal>
              {service.num}
            </span>
            <h3 class="service__title display-service m-0">
              <span class="rv-mask">
                <span data-reveal="rise" data-reveal-delay="0.08">
                  {service.title[0]}
                </span>
              </span>
              <span class="rv-mask">
                <span data-reveal="rise" data-reveal-delay="0.16">
                  {service.title[1]}
                </span>
              </span>
            </h3>
          </div>

          <div class="service__detail">
            <div class="service__tags">
              {service.tags.map((tag, j) => (
                <span class="service__tag" data-reveal data-reveal-delay={0.38 + j * 0.06}>
                  {tag}
                </span>
              ))}
            </div>
            <p class="service__desc" data-reveal data-reveal-delay="0.54">
              {service.desc}
            </p>
          </div>
        </article>
      </div>
    ))
  }
</section>

<style>
  .services__slot {
    position: sticky;
    top: var(--sticky-top);
    margin-bottom: 28px;
    /* Perspective per slot rather than one on the section: a single shared
       vanishing point would skew the cards further from centre. */
    perspective: 1600px;
  }

  .service {
    position: relative;
    /* Cards that get covered sit further back, so the 20px slivers showing
       above the top card read as a stack with depth rather than four flat
       sheets of paper. The last card is the front of the pile, at Z 0. */
    transform: translateZ(calc((var(--i, 0) - 3) * 26px));
    /* Keeps the grain's blend mode working the card and nothing behind it. */
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    min-height: 62vh;
    padding: 56px 60px;
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 -12px 40px rgb(12 16 22 / 0.1);
    color: var(--card-fg);

    /* Two soft pools over the flat ground, lit from a different corner per
       card, so the pile reads as four surfaces catching light rather than
       four swatches. */
    background-color: var(--card-bg);
    background-image:
      radial-gradient(120% 95% at var(--card-light), var(--card-glow-a), transparent 62%),
      radial-gradient(95% 75% at var(--card-light-b), var(--card-glow-b), transparent 68%);
  }

  /* Grain. soft-light keeps it tonal — it never blows out the white ground or
     muddies the ink one, so a single layer serves both colour schemes. */
  .service::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background-image: var(--sw-grain);
    background-size: 180px 180px;
    opacity: var(--card-grain, 0.5);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* Content rides above the grain. */
  .service__lead,
  .service__detail {
    position: relative;
    z-index: 1;
  }

  /* --- recede ------------------------------------------------------------
     A shadow that pools over the card as the next one covers it. Driven by
     --svc-dim (registered in southwell.css) so the keyframes below can
     animate the overlay and the transform together on one timeline. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: var(--ink-950);
    opacity: var(--svc-dim, 0);
    pointer-events: none;
  }

  /* The timeline itself is set inline per card (animation-timeline:
     --svc-N). The range is card N+1's travel from the bottom of the viewport
     up to where it sticks. In lengths, not percentages: a sticky subject's
     view range is stretched by its whole sticky travel, which is different
     for every card, so a percentage would land somewhere else on each. */
  @supports (timeline-scope: --a) {
    .service--covered {
      animation: svc-recede linear both;
      animation-range: cover 40px cover calc(100vh - 130px);
    }
  }

  @keyframes svc-recede {
    to {
      transform: translateZ(calc((var(--i, 0) - 3) * 26px)) translateY(-14px) scale(0.965);
      --svc-dim: 0.14;
    }
  }

  /* Colourways come from the component tier in themes/southwell.css, so all
     four grounds — glows and grain included — re-map themselves in dark mode. */
  .service[data-theme='white'] {
    --card-bg: var(--service-white-bg);
    --card-fg: var(--service-white-fg);
    --card-chip: var(--service-white-chip);
    --card-glow-a: var(--service-white-glow-a);
    --card-glow-b: var(--service-white-glow-b);
    --card-light: var(--service-white-light);
    --card-light-b: var(--service-white-light-b);
    --card-grain: var(--service-white-grain);
  }

  .service[data-theme='mid'] {
    --card-bg: var(--service-mid-bg);
    --card-fg: var(--service-mid-fg);
    --card-chip: var(--service-mid-chip);
    --card-glow-a: var(--service-mid-glow-a);
    --card-glow-b: var(--service-mid-glow-b);
    --card-light: var(--service-mid-light);
    --card-light-b: var(--service-mid-light-b);
    --card-grain: var(--service-mid-grain);
  }

  .service[data-theme='ink'] {
    --card-bg: var(--service-ink-bg);
    --card-fg: var(--service-ink-fg);
    --card-chip: var(--service-ink-chip);
    --card-glow-a: var(--service-ink-glow-a);
    --card-glow-b: var(--service-ink-glow-b);
    --card-light: var(--service-ink-light);
    --card-light-b: var(--service-ink-light-b);
    --card-grain: var(--service-ink-grain);
  }

  .service[data-theme='shade'] {
    --card-bg: var(--service-shade-bg);
    --card-fg: var(--service-shade-fg);
    --card-chip: var(--service-shade-chip);
    --card-glow-a: var(--service-shade-glow-a);
    --card-glow-b: var(--service-shade-glow-b);
    --card-light: var(--service-shade-light);
    --card-light-b: var(--service-shade-light-b);
    --card-grain: var(--service-shade-grain);
  }

  .service__lead {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }

  .service__num {
    font-size: 14px;
    opacity: 0.55;
  }

  .service__detail {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 28px;
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .service__tag {
    padding: 8px 16px;
    border: 1.5px solid var(--card-chip);
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 500;
  }

  .service__desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    opacity: 0.75;
  }

  @media (max-width: 1000px) {
    .service {
      gap: 36px;
      padding: 40px 36px;
    }
  }

  @media (max-width: 800px) {
    .services__slot {
      /* A card taller than the viewport cannot stack cleanly on a phone —
         let them scroll normally instead. */
      position: static;
      margin-bottom: 20px;
      perspective: none;
    }

    .service {
      /* Nothing is stacking, so nothing should be receding. */
      transform: none;
      animation: none;
      grid-template-columns: 1fr;
      gap: 32px;
      min-height: 0;
      padding: 36px 28px;
    }

    .service::after {
      display: none;
    }

    .service__lead {
      gap: 24px;
    }

    .service__desc {
      font-size: 16px;
    }
  }
</style>
