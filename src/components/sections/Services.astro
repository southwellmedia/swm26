---
import SectionHead from './SectionHead.astro';
import ServiceArt from './ServiceArt.astro';
import { services } from '@/config/services.config';
---

<section class="services-section pt-[130px] max-[800px]:pt-[90px]">
  <div class="shell mb-14">
    <SectionHead
      title="Services"
      blurb="Bring us a new idea, a growing business, or something that needs to work better."
      id="services"
    />
  </div>
  <div class="services-story shell" data-services-story>
    <div class="services-stage">
      <ServiceArt /><div class="services-stage__shade"></div><span
        class="services-caption"
        aria-hidden="true">One studio. Many perspectives.</span
      >
    </div>
    <div class="services-chapters">
      {
        services.map((service, i) => (
          <article class="service" data-service-step={i}>
            <div class="service__copy">
              <span class="service__num label-mono">
                {service.num}
                <span> / 04</span>
              </span>
              <h3 class="service__title">
                {service.title[0]}
                <br />
                {service.title[1]}
              </h3>
              <p class="service__desc">{service.desc}</p>
              <div class="service__tags">
                {service.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
<style>
  .services-story {
    position: relative;
    isolation: isolate;
    padding: 0;
    background: #111519;
    color: #eef2f4;
    border-radius: 24px;
  }
  .services-stage {
    position: sticky;
    top: 76px;
    height: max(540px, calc(100svh - 90px));
    min-height: 540px;
    overflow: hidden;
    border-radius: 24px;
  }
  .services-stage__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, #111519 0%, #111519 30%, #111519dd 39%, transparent 60%);
  }
  .services-caption {
    position: absolute;
    bottom: 30px;
    right: 36px;
    color: #a9b0b8;
    font: 10px var(--font-mono);
    letter-spacing: 0.06em;
  }
  .services-chapters {
    position: relative;
    margin-top: calc(-1 * max(540px, 100svh - 90px));
    pointer-events: none;
  }
  .service {
    min-height: max(540px, calc(100svh - 90px));
    display: flex;
    align-items: center;
    padding: 70px 5%;
  }
  .service__copy {
    width: 43%;
    max-width: 480px;
    pointer-events: auto;
  }
  .service__num {
    display: block;
    font-size: 12px;
    margin-bottom: 40px;
  }
  .service__num span {
    opacity: 0.4;
  }
  .service__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.1vw, 76px);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.055em;
    margin: 0 0 34px;
    text-transform: lowercase;
  }
  .service__desc {
    color: #b2bac3;
    font-size: 16px;
    line-height: 1.65;
    max-width: 390px;
    margin: 0 0 30px;
  }
  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font: 10px var(--font-mono);
    color: #818c98;
    max-width: 350px;
  }
  @media (max-width: 800px) {
    .services-story {
      border-radius: 16px;
    }
    .services-stage {
      top: 68px;
      height: max(600px, calc(100svh - 80px));
      min-height: 600px;
    }
    .services-stage__shade {
      background: linear-gradient(0deg, #111519 0%, #111519f5 38%, #11151966 58%, transparent 78%);
    }
    .services-chapters {
      margin-top: calc(-1 * max(600px, 100svh - 80px));
    }
    .service {
      min-height: max(600px, calc(100svh - 80px));
      padding: 310px 28px 48px;
      align-items: flex-end;
    }
    .service__copy {
      width: 100%;
      max-width: none;
    }
    .service__num {
      margin-bottom: 22px;
    }
    .service__title {
      font-size: clamp(38px, 10vw, 58px);
      margin-bottom: 22px;
    }
    .service__desc {
      font-size: 14px;
      margin-bottom: 22px;
    }
    .services-caption {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .services-stage {
      position: sticky;
    }
  }
</style>
