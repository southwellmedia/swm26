---
/**
 * Reel
 *
 * The beat between the hero and the work: a statement headline, a short
 * blurb, and the droplet that left the hero with you. It lands in the empty
 * slot beside the copy; as the section pins, the copy scrolls away at native
 * speed while the droplet blooms into a frame, peels out of its slot, tilts,
 * and opens up to the full width of the shell — a playable droplet scene —
 * then holds there before releasing into the grid below.
 *
 * Structure, top to bottom:
 *
 *   .reel__runway   tall wrapper: 100vh stage + var(--reel-hold) of pinned
 *                   scroll. The hold is the whole scroll budget of the effect.
 *   .reel__stage    position: sticky; the 100vh frame everything sits in.
 *   .reel__copy     headline, blurb and the EMPTY thumbnail slot. Translated
 *                   up by the engine while pinned so it reads as scrolling.
 *   .reel__full     the EMPTY full-width slot, centred in the stage.
 *   <video>/<img>   the fallback only: shown in the full slot when the
 *                   engine cannot run. Live, the frame draws its own scene.
 *   <canvas>        fixed to the viewport; the droplet and frame are drawn
 *                   here, over the hero, the gap and the stage alike.
 *
 * The two slots are plain boxes: the WebGL quad is measured to them, so the
 * layout stays CSS and the effect follows whatever the grid decides. Engine
 * in src/scripts/reel/morph.ts; the hero publishes its droplet for it, see
 * HeroScene.tsx.
 *
 * Fallbacks, in order: no JS — the video sits in the full slot, the thumbnail
 * slot collapses. Reduced motion or no WebGL — same, decided in the script.
 */
import { Icon } from 'astro-icon/components';
import PillButton from '@/components/site/PillButton.astro';

interface Props {
  /** mp4/webm, or a still (jpg, png, webp, avif), for the fallback frame
   *  when the WebGL scene cannot run. */
  src: string;
  /** Poster for a video fallback. Unused for a still. */
  poster: string;
  title?: string;
  blurb?: string;
  /** Extra pinned scroll, as a CSS length. Bigger = slower, longer morph. */
  hold?: string;
  class?: string;
}

const {
  src,
  poster,
  title = 'Bold ideas, built to ship.',
  blurb = 'Design, motion and engineering under one roof — from the first sketch to the last deploy.',
  hold = '160vh',
  class: className,
} = Astro.props;

const isStill = /\.(jpe?g|png|webp|avif|gif)(\?.*)?$/i.test(src);

// The disciplines, one per droplet in the scene, in the order the scene
// numbers them. Short, because they ride on the droplets.
const LABELS = [
  { text: 'Development', href: '/#services' },
  { text: 'Prototypes', href: '/#services' },
  { text: 'Brand & design', href: '/#services' },
  { text: 'Advisory', href: '/#services' },
];
---

<section class:list={['reel', className]} data-reel style={`--reel-hold-set: ${hold}`}>
  <div class="reel__runway" data-reel-runway>
    <div class="reel__stage shell" data-reel-stage>
      <div class="reel__copy" data-reel-copy>
        <header class="reel__head" data-reveal>
          <h2 class="display-section m-0">{title}</h2>
          <p
            class="text-foreground-secondary m-0 max-w-[380px] text-[18px] leading-[1.55] max-[800px]:text-base"
          >
            {blurb}
          </p>
        </header>
        <div class="reel__thumb" data-reel-thumb aria-hidden="true"></div>
      </div>

      <div class="reel__fullwrap" aria-hidden="true">
        <div class="reel__full" data-reel-full>
          {
            isStill ? (
              <img class="reel__video" data-reel-source src={src} alt="" decoding="async" />
            ) : (
              <video
                class="reel__video"
                data-reel-source
                muted
                loop
                playsinline
                autoplay
                preload="metadata"
                poster={poster}
                crossorigin="anonymous"
              >
                <source src={src} />
              </video>
            )
          }
        </div>
      </div>
    </div>
  </div>

  {
    /* Fixed to the viewport, not inside the stage: the droplet is drawn over
      the hero and the gap before the stage ever pins. Outside the sticky,
      overflow-hidden stage so nothing clips or re-parents it. */
  }
  <canvas class="reel__canvas" data-reel-canvas aria-hidden="true"></canvas>

  {
    /* Above the canvas, on the open frame's rectangle (the engine sizes it):
      the discipline labels that ride on the droplets, the line that follows
      the scene's state, and the call to action. Hidden until the frame is
      open, so nothing here is reachable before it can be seen. */
  }
  <div class="reel__overlay" data-reel-overlay>
    {
      LABELS.map((label, i) => (
        <a class="reel__label label-mono" href={label.href} data-reel-label={i} tabindex="-1">
          {label.text}
        </a>
      ))
    }
    <div class="reel__caption">
      <p class="reel__line reel__line--chaos m-0" aria-hidden="true">
        Every project starts as pieces.
      </p>
      <p class="reel__line reel__line--clear m-0">One team ships the clear version.</p>
      <PillButton href="/contact" class="reel__cta px-7 py-3.5">
        Start a project
        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </PillButton>
    </div>
  </div>
</section>

<style>
  .reel {
    position: relative;
    /* The prop arrives as an inline --reel-hold-set. Resolving it here, in
       the stylesheet, is what lets the static mode below zero it: an inline
       --reel-hold would beat any rule. */
    --reel-hold: var(--reel-hold-set, 160vh);
  }

  .reel__runway {
    /* The stage plus the pinned budget. */
    height: calc(100vh + var(--reel-hold, 160vh));
    height: calc(100svh + var(--reel-hold, 160vh));
  }

  .reel__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    /* Clip the copy as it leaves the top, exactly as the viewport would. */
    overflow: hidden;
  }

  .reel__copy {
    position: relative;
    z-index: 1;
    padding-top: 130px;
    /* Written by the engine while pinned; never animated by CSS, so the
       translate tracks the scroll 1:1 with no easing of its own. */
    will-change: transform;
  }

  .reel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 40px;
  }

  /* The empty slot the picture starts in. 5/12 of the shell, like the lead
     column of the grid below. It only defines a rectangle. */
  .reel__thumb {
    width: calc(5 / 12 * 100% - 10px);
    aspect-ratio: 16 / 9;
    margin-top: 56px;
    border-radius: var(--radius-lg);
  }

  .reel__fullwrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  /* The slot the picture ends in: the width of the shell, capped so a very
     wide viewport still shows the whole frame with air above and below. */
  .reel__full {
    position: relative;
    width: min(100%, calc(78vh * 16 / 9));
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--work-media-bg, var(--color-background-secondary));
  }

  .reel__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Above the page, below the nav (55/60). Pointer events pass through: the
     engine listens on the window and works out for itself what was hit. */
  .reel__canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 40;
    pointer-events: none;
  }

  /* --- the words on the open frame ------------------------------------ */
  .reel__overlay {
    position: fixed;
    z-index: 41;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-sw),
      visibility 0s 0.45s;
  }

  .reel[data-reel-open] .reel__overlay {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.6s var(--ease-sw) 0.1s,
      visibility 0s;
  }

  /* Each label is placed by the engine on its droplet; it only fades here. */
  .reel__label {
    position: absolute;
    top: 0;
    left: 0;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgb(12 16 22 / 0.72);
    color: rgb(255 255 255 / 0.9);
    text-decoration: none;
    white-space: nowrap;
    pointer-events: auto;
    will-change: transform, opacity;
    transition: background-color 0.3s ease;
  }

  .reel__label:hover {
    background: rgb(12 16 22 / 0.92);
  }

  .reel__caption {
    position: absolute;
    left: 36px;
    bottom: 32px;
    display: grid;
    gap: 18px;
    max-width: 420px;
  }

  /* Two lines in one slot; the scene's state picks which shows. */
  .reel__line {
    grid-area: 1 / 1;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: var(--display-weight);
    line-height: 1.1;
    letter-spacing: var(--display-tracking);
    color: var(--ink-950);
    transition:
      opacity 0.5s var(--ease-sw),
      transform 0.5s var(--ease-sw);
  }

  .reel__line--clear,
  .reel[data-reel-clear] .reel__line--chaos {
    opacity: 0;
    transform: translateY(8px);
  }

  .reel[data-reel-clear] .reel__line--clear {
    opacity: 1;
    transform: none;
  }

  /* The pill is rendered by a child component, so its class carries no
     scope attribute: reach it through the caption. */
  .reel__caption :global(.reel__cta) {
    grid-area: 2 / 1;
    justify-self: start;
    pointer-events: auto;
  }

  .reel__caption :global(.reel__cta svg) {
    width: 16px;
    height: 16px;
    stroke-width: 2;
  }

  @media (max-width: 800px) {
    .reel__caption {
      left: 20px;
      bottom: 20px;
      gap: 12px;
    }

    .reel__label {
      padding: 4px 9px;
    }
  }

  /* --- modes ------------------------------------------------------------- */
  /* Live: the DOM video is only a texture source. Kept in layout so it keeps
     decoding; invisible so it never double-draws. The full slot is only a
     measuring box here too — its backdrop is for the fallback, and would
     otherwise sit behind the copy as a plain grey frame the whole time. */
  .reel[data-reel-mode='live'] .reel__video {
    opacity: 0;
  }

  .reel[data-reel-mode='live'] .reel__full {
    background: transparent;
  }

  /* Static (no JS, reduced motion, no WebGL): no canvas, no travelling slot,
     the video simply sits in the full frame and the pinned budget goes. */
  :global(html:not(.js)) .reel,
  .reel[data-reel-mode='static'] {
    --reel-hold: 0px;
  }

  :global(html:not(.js)) .reel__canvas,
  .reel[data-reel-mode='static'] .reel__canvas,
  :global(html:not(.js)) .reel__thumb,
  .reel[data-reel-mode='static'] .reel__thumb {
    display: none;
  }

  :global(html:not(.js)) .reel__runway,
  .reel[data-reel-mode='static'] .reel__runway,
  :global(html:not(.js)) .reel__stage,
  .reel[data-reel-mode='static'] .reel__stage {
    position: relative;
    height: auto;
    overflow: visible;
  }

  :global(html:not(.js)) .reel__fullwrap,
  .reel[data-reel-mode='static'] .reel__fullwrap {
    position: relative;
    inset: auto;
    padding: 56px 0 0;
  }

  @media (max-width: 800px) {
    .reel__copy {
      padding-top: 90px;
    }

    .reel__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .reel__thumb {
      width: 62%;
      margin-top: 36px;
    }
  }
</style>

<script>
  /* Boots the morph engine for the reel on this page.

     Lazy on two counts: the engine (and three) is only imported once the
     section is within a viewport of the fold, and it only renders while the
     stage is on screen. Reduced motion and no-WebGL fall back to the static
     mode, which the stylesheet handles.

     One engine per document: built on astro:page-load, torn down before the
     swap so its observers and GL context never outlive their DOM. */
  import type { ReelMorph } from '@/scripts/reel/morph';

  let engine: ReelMorph | null = null;
  let observer: IntersectionObserver | null = null;

  const hasWebGL = (canvas: HTMLCanvasElement) => {
    try {
      return Boolean(canvas.getContext('webgl2') || canvas.getContext('webgl'));
    } catch {
      return false;
    }
  };

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-reel]');
    if (!root) return;

    const canvas = root.querySelector<HTMLCanvasElement>('[data-reel-canvas]');
    const stage = root.querySelector<HTMLElement>('[data-reel-stage]');
    const runway = root.querySelector<HTMLElement>('[data-reel-runway]');
    const thumb = root.querySelector<HTMLElement>('[data-reel-thumb]');
    const full = root.querySelector<HTMLElement>('[data-reel-full]');
    const copy = root.querySelector<HTMLElement>('[data-reel-copy]');
    if (!canvas || !stage || !runway || !thumb || !full) return;

    // The work grid's lead card waits to be delivered by the droplet. With
    // no engine to do that, or when the page opens already past the reel,
    // it simply shows; the engine keeps that in step once it runs.
    const lead = document.querySelector<HTMLElement>('[data-work-grid] .card[data-deliver]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !hasWebGL(document.createElement('canvas'))) {
      root.dataset.reelMode = 'static';
      lead?.classList.add('is-in');
      return;
    }

    root.dataset.reelMode = 'live';
    if (lead && runway.getBoundingClientRect().bottom < 0) lead.classList.add('is-in');

    observer = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        observer?.disconnect();
        observer = null;
        const { createReelMorph } = await import('@/scripts/reel/morph');
        // The page may have swapped while three was loading.
        if (!root.isConnected) return;
        const lenis = window.__lenis;
        engine = createReelMorph({
          canvas,
          root,
          stage,
          runway,
          thumb,
          full,
          copy: copy ?? undefined,
          // The hero: where the droplet emerges, what it lands on, and where
          // the --hero-* palette hooks live.
          heroPanel: document.querySelector<HTMLElement>('.hero__render'),
          heroFloor: document.querySelector<HTMLElement>('.hero__foot'),
          paletteScope: document.querySelector<HTMLElement>('.hero'),
          // The words on the open frame.
          overlay: root.querySelector<HTMLElement>('[data-reel-overlay]'),
          labels: Array.from(root.querySelectorAll<HTMLElement>('[data-reel-label]')),
          // Where the ball ends up: bouncing on the Work heading into the
          // card the grid marked for delivery.
          workHead: document.querySelector<HTMLElement>('#work'),
          leadCard: document.querySelector<HTMLElement>('[data-work-grid] .card[data-deliver]'),
          radius: parseFloat(getComputedStyle(full).borderRadius) || 16,
          // Lenis's velocity is the value the page is drawn at, so the bend
          // can never disagree with the scroll. Falls back to a scroll delta.
          velocity: lenis ? () => Math.max(-1, Math.min(1, lenis.velocity / 42)) : undefined,
        });
        engine.start();
      },
      { rootMargin: '100% 0px' }
    );
    observer.observe(root);
  }

  function teardown() {
    observer?.disconnect();
    observer = null;
    engine?.destroy();
    engine = null;
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', teardown);
</script>
