---
/**
 * StudioProcess: how a project runs, as four steps on one ink band.
 *
 * The band is the studio hero's frame again, so the page opens and turns on
 * the same surface. Four equal columns on desktop, two on a tablet, one on
 * a phone; every step has the same parts in the same order, so the eye can
 * run along a row and compare.
 */
const steps = [
  {
    short: 'Talk',
    title: 'Start with a conversation.',
    text: 'Tell me what you’re working toward and what is getting in the way. We’ll talk about the people using it, what already exists, and what would make this worth doing.',
    takeaway: 'Bring the context. We’ll find the right questions together.',
  },
  {
    short: 'Shape',
    title: 'Find the shape of it.',
    text: 'We turn that conversation into a direction: what we’re building, what belongs in it, and how it should feel. You’re part of the decisions as the idea starts to become something you can see.',
    takeaway: 'Your feedback shapes the work while it’s taking shape.',
  },
  {
    short: 'Build',
    title: 'Make it work in the real world.',
    text: 'This is where the pieces come together. I work through the design and development, with you involved as it becomes a working website or application. We look at how it feels to use, as well as how it looks.',
    takeaway: 'The person designing it is also building it.',
  },
  {
    short: 'Grow',
    title: 'Keep the conversation going.',
    text: 'Launch is a milestone in our relationship. As people use what we’ve built, we can learn from it, improve it, and figure out what comes next. You still know who to call.',
    takeaway: 'A familiar face for the next chapter, too.',
  },
];
---

<section class="studio-process shell" id="the-approach" aria-labelledby="approach-title">
  <div class="studio-process__frame">
    <header class="studio-block__head">
      <p class="studio-kicker">04 / The approach</p>
      <h2 id="approach-title" class="studio-statement" data-reveal>
        We work through it. <em>Together.</em>
      </h2>
    </header>
    <ol class="studio-steps">
      {
        steps.map((step, i) => (
          <li class="studio-step">
            <p class="studio-step__num">
              0{i + 1}
              <span>{step.short}</span>
            </p>
            <h3>{step.title}</h3>
            <p class="studio-step__text">{step.text}</p>
            <p class="studio-step__takeaway">{step.takeaway}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
