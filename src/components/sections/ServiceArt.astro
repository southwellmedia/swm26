---
import { particlePosition, accentWeight } from '@/scripts/particle-layout';
interface Props { index: number }
const { index } = Astro.props;
const dots = Array.from({ length: 160 }, (_, i) => {
  const u = (i * .61803398875) % 1;
  const spread = Math.sin(i * 12.9898) * Math.cos(i * 4.1414);
  const accent = i % 5 === 0;
  const depth = (i * .41421356237) % 1;
  const point = particlePosition(u, spread, depth, i, 0, 0, index, accent);
  const weight = accentWeight((i * .754877666) % 1);
  return { x: point.x * 720, y: point.y * 400, r: accent ? weight.radius : .8 + depth, accent, opacity: accent ? weight.opacity : .25 };
});
---
<div class="service-art" data-particle-field data-particle-variant={index} aria-hidden="true">
  <svg viewBox="0 0 720 400" preserveAspectRatio="xMidYMid slice">
    {dots.map(dot => <circle cx={dot.x} cy={dot.y} r={dot.r} fill={dot.accent ? 'var(--signature-color, #ff542e)' : 'currentColor'} opacity={dot.opacity} />)}
  </svg>
  <canvas></canvas>
</div>
<script>
  import { mountParticles } from '@/scripts/service-particles';
  // Each field is a WebGL context and a shader compile, and they sit far below
  // the fold. Mounting all of them on load stalled the first paint's main
  // thread; mounting on approach put the compile in the middle of a scroll. So
  // they mount in idle time, one per slot, with the static SVG holding the
  // place. Scrolling there first still works: the watcher mounts on approach.
  let watcher: IntersectionObserver | null = null;
  let idle = 0;
  // Safari has no idle callback; a short timer does the same job there.
  const hasIdle = typeof window.requestIdleCallback === 'function';
  const later = (run: () => void) =>
    hasIdle ? window.requestIdleCallback(run, { timeout: 4000 }) : window.setTimeout(run, 400);
  const cancel = (id: number) =>
    hasIdle ? window.cancelIdleCallback(id) : window.clearTimeout(id);
  const mount = (host: HTMLElement) => {
    watcher?.unobserve(host);
    if (host.dataset.mounted) return;
    host.dataset.mounted = 'true';
    mountParticles(host);
  };
  const stop = () => {
    watcher?.disconnect();
    watcher = null;
    cancel(idle);
  };
  const init = () => {
    stop();
    const hosts = [...document.querySelectorAll<HTMLElement>('[data-particle-field]')];
    if (!hosts.length) return;
    watcher = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) mount(entry.target as HTMLElement);
    }, { rootMargin: '100% 0px' });
    hosts.forEach((host) => watcher?.observe(host));
    const next = () => {
      const host = hosts.find((candidate) => !candidate.dataset.mounted);
      if (!host) return;
      mount(host);
      idle = later(next);
    };
    idle = later(next);
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', stop);
</script>
<style>
/* The fade into the copy is a mask on the static SVG only; the live canvas
   draws the same fade itself (service-particles.ts), since a mask over a
   canvas is recomposited every frame. */
.service-art { position:absolute; inset:0 0 0 43%; overflow:hidden; color:var(--card-fg); pointer-events:none; }
.service-art canvas,.service-art svg { position:absolute; width:100%;height:100%;inset:0; }
.service-art svg { mask-image:linear-gradient(90deg,transparent,#000 18%); }
.service-art canvas { opacity:0; }
.service-art[data-ready=true] canvas { opacity:1; }
.service-art[data-ready=true] svg { opacity:0; }
@media(max-width:800px) { .service-art { position:relative; inset:auto; height:250px; margin:-20px -28px 0; } .service-art svg { mask-image:linear-gradient(0deg,transparent,#000 16%); } }
</style>
