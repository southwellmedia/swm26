---
import { Image } from 'astro:assets';
import sculpture from '@/assets/services/pleated-titanium.webp';
---

<div class="service-art" data-sculpture aria-hidden="true">
  <Image src={sculpture} alt="" widths={[800, 1280, 1840]} sizes="95vw" loading="lazy" />
  <canvas></canvas>
</div>
<script>
  import { mountSculpture } from '@/scripts/service-tension';
  const init = () =>
    document.querySelectorAll<HTMLElement>('[data-sculpture]').forEach((host) => {
      if (host.dataset.mounted) return;
      host.dataset.mounted = 'true';
      mountSculpture(host);
    });
  init();
  document.addEventListener('astro:page-load', init);
</script>
<style>
  .service-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #111519;
  }
  .service-art :global(img) {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.3);
  }
  .service-art canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .service-art[data-ready='true'] canvas {
    opacity: 1;
  }
  .service-art[data-ready='true'] :global(img) {
    opacity: 0;
  }
</style>
