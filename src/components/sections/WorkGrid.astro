---
/**
 * WorkGrid
 *
 * A bento grid of projects. Reads the work collection, so the homepage and
 * /work stay in step with one file per project.
 *
 * Footprints come from position, not from the project. Hand-assigning a span
 * per project is what left holes in the grid: dense packing fills a gap only
 * with a LATER item that happens to fit, so one awkward span strands
 * whitespace no amount of reordering reliably clears.
 *
 * Instead the lead project takes the full width, and everything after it draws
 * from PATTERN, a repeating run whose every segment completes whole rows. The
 * grid cannot develop a hole, whatever the project count.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SectionHead from './SectionHead.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import PillButton from '@/components/site/PillButton.astro';

interface Props {
  /** How many projects the grid shows. Omit for all of them. */
  count?: number;
  /** The shared giant-title header. Off on /work, which has its own. */
  showHead?: boolean;
  /** The "See all work" button under the grid. */
  showMore?: boolean;
  class?: string;
}

const { count, showHead = true, showMore = true, class: className } = Astro.props;

// Projects told inside a story page (`parent`) are left to that page.
const projects = (await getCollection('work', ({ data }) => !data.draft && !data.parent)).sort(
  (a, b) => a.data.order - b.data.order
);

const shown = typeof count === 'number' ? projects.slice(0, count) : projects;
const remaining = projects.length - shown.length;

// A card's span decides how wide it actually renders, so it has to decide the
// srcset too. One shared `sizes` would either starve the full-width lead card
// or make every 1x1 download a picture three times the size it displays.
// Breakpoints mirror the grid: 3 columns, 2 below 1100px, 1 below 700px.
// Every segment of this run closes off whole rows on a 3-column grid:
//   large + standard + standard  -> 2 rows  (a 2x2 beside a stack of two)
//   wide  + standard             -> 1 row
//   wide  + standard             -> 1 row
//   standard x3                  -> 1 row
// Ten items, five rows, exactly. The lead card sits above all of it at full
// width and two rows deep, so counts of 1, 6 and 11 land on a row boundary.
const PATTERN = [
  'large',
  'standard',
  'standard',
  'wide',
  'standard',
  'wide',
  'standard',
  'standard',
  'standard',
  'standard',
] as const;

const spanFor = (index: number) => (index === 0 ? 'hero' : PATTERN[(index - 1) % PATTERN.length]);

const SIZING: Record<'hero' | 'large' | 'wide' | 'standard', { widths: number[]; sizes: string }> =
  {
    hero: {
      widths: [640, 1024, 1536, 2048],
      sizes: '(max-width: 1100px) 100vw, 1344px',
    },
    large: {
      widths: [480, 896, 1440],
      sizes: '(max-width: 700px) 100vw, (max-width: 1100px) 100vw, 896px',
    },
    wide: {
      widths: [480, 896, 1440],
      sizes: '(max-width: 700px) 100vw, (max-width: 1100px) 100vw, 896px',
    },
    standard: {
      widths: [360, 640, 960],
      sizes: '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 448px',
    },
  };
---

<section class:list={['shell pt-[130px] pb-15 max-[800px]:pt-[90px]', className]}>
  {
    showHead && (
      <SectionHead
        title="Work"
        blurb="A diligent little studio, obsessed with turning ideas into digital realities."
        id="work"
      />
    )
  }

  <div class="bento mt-16 max-[800px]:mt-10" data-work-grid>
    {
      shown.map((project, i) => {
        const span = spanFor(i);
        const sizing = SIZING[span];
        const rest = project.data.feature ?? project.data.cover;
        const reveal = project.data.cover ?? project.data.feature;
        return (
          <a class="card" href={'/work/' + project.id} data-span={span} data-card>
            <div class="card__media">
              {/* Two layers: the rest picture, desaturated in the stylesheet,
                and the colour picture that dissolves over it on hover. With a
                feature and a cover the hover also swaps photograph for mockup;
                with only one, both layers hold the same file (one download,
                one decode) and the hover is purely the colour coming up.
                Colour never comes from animating a filter — that is what
                made the first hover snap; see the stylesheet. */}
              {rest && (
                <Image
                  src={rest}
                  alt={project.data.coverAlt ?? project.data.title}
                  layout="none"
                  widths={sizing.widths}
                  sizes={sizing.sizes}
                  class="card__img card__img--rest"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              )}

              {reveal && (
                <Image
                  src={reveal}
                  alt=""
                  layout="none"
                  widths={sizing.widths}
                  sizes={sizing.sizes}
                  class="card__img card__img--reveal"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}

              {!rest && (
                <Placeholder
                  class="h-full w-full rounded-none"
                  label={project.data.placeholder ?? project.data.title}
                />
              )}
            </div>

            <div class="card__view" aria-hidden="true">
              <span class="card__view-pill">
                View project
                <Icon name="lucide:arrow-up-right" aria-hidden="true" />
              </span>
            </div>

            <div class="card__caption">
              <span class="card__name">{project.data.title}</span>
            </div>

            <span class="card__meta label-mono">{project.data.discipline}</span>
          </a>
        );
      })
    }
  </div>

  {
    showMore && (
      <div class="mt-[72px] flex justify-center" data-reveal>
        <PillButton href="/work" variant="outline" class="px-9 py-4">
          {remaining > 0 ? 'See all ' + projects.length + ' projects' : 'See all work'}
          <Icon name="lucide:arrow-right" aria-hidden="true" />
        </PillButton>
      </div>
    )
  }
</section>

<style>
  /* Dense flow lets a 1x1 backfill a hole left by a 2x2, so the grid stays
     solid regardless of how many projects are shown. */
  .bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    grid-auto-flow: dense;
    gap: 20px;
  }

  /* The card's own box never moves. Depth comes from the layers inside it
     drifting against each other, which `overflow: hidden` then clips — so a
     card can't reach into the 20px gap and touch its neighbours no matter how
     far the pointer travels. Rotating the card itself is what did that: at 9°
     the projected corners overrun the gap on their own.

     The shadow is static. Animating it repaints a 36px blur across the
     whole card every frame, and it never read as part of the hover anyway.

     Hover, in general: only opacity and transform ever animate in here, on
     layers that already exist. The first version animated a grayscale filter
     on the media wrapper, and Chrome had to build a filtered surface and
     raster both full-size pictures before it could show the first hover
     frame — by which time the transition had already run out, so the first
     hover on each card cut straight to its end state. */
  .card {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--work-media-bg);
    box-shadow: 0 18px 36px rgb(12 16 22 / 0.1);
  }

  /* Pre-arrival state; Motion's first keyframe overrides it inline. See
     src/scripts/motion/work.ts. */
  :global(html.js) .card:not(.is-in) {
    opacity: 0;
  }

  /* The lead project takes the full width of the grid. */
  .card[data-span='hero'] {
    grid-column: 1 / -1;
    grid-row: span 2;
  }

  .card[data-span='large'] {
    grid-column: span 2;
    grid-row: span 2;
  }

  .card[data-span='wide'] {
    grid-column: span 2;
  }

  /* The media fills the cell and is the zoom target, so the card's footprint
     is set by the grid rather than by the image. Its transform (arrival zoom,
     hover drift and zoom) belongs to Motion — nothing here touches it. It is
     a layer of its own from the start, so Motion's per-frame writes never
     re-raster the pictures inside. */
  .card__media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The rest picture is desaturated and dimmed for good — a static filter is
     baked into the raster once and costs nothing after. See --work-rest-* in
     themes/southwell.css. It stays put under the colour layer rather than
     fading out against it: two pictures crossing at half opacity let the
     card's background through mid-fade, which is what read as a flash. */
  .card__img--rest {
    filter: grayscale(var(--work-rest-grayscale)) contrast(var(--work-rest-contrast));
    opacity: var(--work-rest-opacity);
  }

  /* The colour picture waits on top, near-invisible, and dissolves in. The
     settle-from-a-zoom that goes with it is the media wrapper's, driven by
     Motion, not a transform transition here: Chrome re-rasters a layer at
     its final scale the moment a CSS transform transition ends, and on a
     card this size that takes longer than a frame — so the layer drew empty
     for one frame, a flash of the grey picture under a fully-risen pill.
     Opacity never re-rasters.

     Near-zero rather than zero: Chrome does not raster a layer at exactly 0,
     and rastering it on the first hover is the pause that made that hover
     snap. At 0.001 the layer is drawn (and so kept ready) while contributing
     nothing you could see. */
  .card__img--reveal {
    opacity: 0.001;
    will-change: opacity;
    transition: opacity 0.9s var(--ease-sw);
  }

  .card:hover .card__img--reveal,
  .card:focus-visible .card__img--reveal {
    opacity: 1;
  }

  /* No hover on touch: show the colour picture, and never leave a half-faded
     state. */
  @media (hover: none) {
    .card__img--reveal {
      opacity: 1;
      transition: none;
    }
  }

  .card__media :global(.placeholder) {
    background-color: var(--work-media-bg);
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(12 16 22 / 0.1) 0,
      rgb(12 16 22 / 0.1) 9px,
      transparent 9px,
      transparent 18px
    );
  }

  /* The pill follows the dissolve in by a beat and leaves at once. Same
     near-zero resting opacity as the colour layer, for the same reason, and
     it rises rather than scales so its raster scale never changes either. */
  .card__view {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0.001;
    transform: translateY(12px);
    will-change: opacity, transform;
    transition:
      opacity 0.35s ease,
      transform 0.45s var(--ease-sw);
  }

  .card:hover .card__view,
  .card:focus-visible .card__view {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.5s ease 0.15s,
      transform 0.7s var(--ease-sw) 0.15s;
  }

  .card__view-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 14px 24px;
    border-radius: var(--radius-full);
    background: var(--ice-100);
    color: var(--ink-950);
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgb(12 16 22 / 0.25);
  }

  .card__view-pill :global(svg) {
    width: 17px;
    height: 17px;
    stroke-width: 2;
  }

  /* Caption and meta chip sit on the image, so they stay light in both colour
     schemes rather than following the page tokens. */
  .card__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 24px 26px;
    pointer-events: none;
    background: linear-gradient(to top, rgb(12 16 22 / 0.6), transparent);
    /* Motion moves this against the picture under the pointer. The
       opposition is the whole effect — same direction would just look like
       sliding. A layer of its own for the same reason as the media. */
    will-change: transform;
  }

  .card__name {
    display: block;
    font-family: var(--font-display);
    color: #fff;
    font-size: 30px;
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
  }

  /* Bigger cells get bigger type, so the grid has a clear focal point. */
  .card[data-span='hero'] .card__name {
    font-size: clamp(2.75rem, 4.6vw, 4.5rem);
  }

  .card[data-span='large'] .card__name {
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
  }

  .card[data-span='hero'] .card__caption {
    padding: 40px 44px;
  }

  .card[data-span='large'] .card__caption,
  .card[data-span='wide'] .card__caption {
    padding: 32px 36px;
  }

  .card[data-span='wide'] .card__name {
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
  }

  .card__meta {
    position: absolute;
    top: 20px;
    right: 22px;
    padding: 6px 13px;
    border-radius: var(--radius-full);
    /* A touch more opaque than it was with a blur behind it. No backdrop
       filter: one per card is a live blur that re-samples whenever the media
       under it moves, which on hover is every frame. */
    background: rgb(12 16 22 / 0.55);
    color: rgb(255 255 255 / 0.88);
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 260px;
    }

    .card[data-span='hero'] {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: 300px;
      gap: 14px;
    }

    .card[data-span='large'],
    .card[data-span='wide'],
    .card[data-span='hero'] {
      grid-column: span 1;
    }

    .card[data-span='large'],
    .card[data-span='hero'] {
      grid-row: span 1;
    }

    .card__name,
    .card[data-span='large'] .card__name,
    .card[data-span='hero'] .card__name {
      font-size: 2rem;
    }

    .card__caption,
    .card[data-span='large'] .card__caption,
    .card[data-span='hero'] .card__caption {
      padding: 22px 24px;
    }
  }
</style>
