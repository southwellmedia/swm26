---
/**
 * Hero
 *
 * A panel with the headline overlapping its lower edge, and a staggered
 * load-in: the panel settles, each headline line rises out of its mask, then
 * the foot follows. The sequence lives in src/scripts/motion/hero.ts; the
 * stylesheet only holds the pre-animation state, behind `html.js`.
 *
 * The panel is HeroVisual — CSS, not an image. Client work does not belong
 * here; the first thing on the page has to carry the studio's own brand.
 * Setting the treatment to `none` removes the panel entirely and lets the type
 * carry the page, which is a legitimate answer rather than a fallback.
 *
 * HeroScene ("Clarity in Chaos") is slotted into the panel: an interactive
 * WebGL rod field that resolves into order around the cursor. It hydrates on
 * idle so it never competes with the type for the first paint; the CSS
 * treatments underneath are the no-JS / pre-hydration state.
 *
 * The section is pinned, the same way the reel is: a sticky, full-height
 * stage on a runway that is `hold` taller. While the runway scrolls the
 * stage holds still, so the droplet that leaves the panel and lands on the
 * headline (src/scripts/reel/handoff.ts) has a whole screen of scroll to
 * fall in and a floor that is not moving away from it. The hold has to run
 * to REST_END there: hold = REST_END, in viewport heights. While pinned the
 * foot (blurb and scroll cue) fades and lifts with the scroll, driven by the
 * reel's engine through --hero-foot-y / --hero-foot-o, so the page answers
 * the first pixel of scroll rather than sitting still. Without JS,
 * or when the reel's engine cannot run (data-hero-mode="static", set by the
 * reel's script), the runway collapses and the hero is a plain section.
 */
import HeroVisual from '@/components/site/HeroVisual.astro';
import HeroScene from '@/components/site/HeroScene.tsx';

interface Props {
  /** Pinned scroll after the stage, as a CSS length. */
  hold?: string;
}

const { hold = '80vh' } = Astro.props;
---

<section class="hero" data-hero style={`--hero-hold-set: ${hold}`}>
<div class="hero__runway">
<div class="hero__stage shell flex flex-col justify-end pt-24 pb-9 max-[700px]:pt-[84px]">
  {
    /* On a phone the content is shorter than the screen, and with the column
      bottom-aligned the slack would sit as a gap under the nav; the panel
      grows to take it instead, never shorter than 42vh. */
  }
  <HeroVisual
    class="hero__render h-[58vh] max-[700px]:h-auto max-[700px]:min-h-[42vh] max-[700px]:flex-1"
  >
    <HeroScene client:idle />
    {
      /* The panel dissolves into the page along its lower edge rather than
        ending in a hard line behind the headline. A painted gradient in the
        page colour, not a mask: masking a container with a live WebGL canvas
        inside costs a compositing pass every frame. */
    }
    <div class="hero__fade" aria-hidden="true"></div>
  </HeroVisual>

  <h1 class="hero__headline display-hero">
    <span class="hero__line"
      ><span class="hero__word hero__word--1">A Dallas creative studio</span></span
    >
    <span class="hero__line"
      ><span class="hero__word hero__word--2"
        ><em>for websites, apps and brands.</em>{
          /* A zero-size inline-block sat on the baseline: the reel's droplet
            lands on this line, and reads where the baseline is from here. */
        }<span class="hero__baseline" aria-hidden="true"></span></span
      ></span
    >
  </h1>

  <div class="hero__foot mt-9 flex items-end justify-between gap-10">
    <p class="text-foreground-secondary m-0 max-w-[440px] text-[17px] leading-[1.6]">
      <strong class="text-foreground font-medium">Work that earns its keep.</strong>
      {' '}Southwell Media is a Dallas-based creative studio building original websites, apps and
      brands: no templates, no themes, shipped in weeks.
    </p>

    <div class="hero__scroll" aria-hidden="true">
      Scroll
      <span class="hero__scroll-line"></span>
    </div>
  </div>
</div>
</div>
</section>

<style>
  .hero {
    position: relative;
    /* The prop arrives as an inline --hero-hold-set. Resolved here, in the
       stylesheet, so the static mode below can zero it: an inline
       --hero-hold would beat any rule. */
    --hero-hold: var(--hero-hold-set, 80vh);
    /* Art direction for the WebGL scene lives here as --hero-* custom
       properties (see HeroScene.tsx for every hook). Unset, the scene is
       monochrome from the theme greys with a neutral studio light. */
    --hero-warm: #ffffff;
    --hero-cool: #f4f7fa;
  }

  .hero__runway {
    /* The stage plus the pinned budget. */
    height: calc(100vh + var(--hero-hold, 80vh));
    height: calc(100svh + var(--hero-hold, 80vh));
  }

  .hero__stage {
    position: sticky;
    top: 0;
    /* The screen, and no more: taller and it would pin for less than the
       hold. On a phone the panel flexes to fill it (see HeroVisual below). */
    height: 100vh;
    height: 100svh;
    /* The headline is sized in container units off this box (the shell),
       so it is one line per row at every width. Inline-size containment
       only; the stage keeps its own height. */
    container-type: inline-size;
  }

  :global(html:not(.js)) .hero__runway,
  .hero[data-hero-mode='static'] .hero__runway {
    height: auto;
  }

  :global(html:not(.js)) .hero__stage,
  .hero[data-hero-mode='static'] .hero__stage {
    position: relative;
    height: auto;
    min-height: 100vh;
    min-height: 100svh;
  }

  .hero__render {
    /* Set to `none` by the treatment token, which collapses the panel and
       leaves a type-only hero. */
    display: var(--hero-panel-display, block);
    transform-origin: 50% 80%;
  }

  /* Pre-animation state. Motion writes its first keyframe inline, and inline
     beats these, so there is never a frame of the finished layout before the
     entrance. Without JS the class is absent and everything simply shows. */
  :global(html.js) .hero__render,
  :global(html.js) .hero__foot {
    opacity: 0;
  }

  :global(html.js) .hero__word {
    transform: translateY(112%);
  }

  /* The headline rides up over the panel rather than sitting under it. When
     there is no panel it needs no overlap, so the pull-up is a token too. */
  .hero__headline {
    position: relative;
    /* A flex column, not a block: each .hero__line below carries a negative
       margin that must cancel its own mask padding exactly. Block siblings
       collapse adjoining negative margins to the MOST negative one, not the
       sum, which leaked 0.12em of air between the two lines. Flex items never
       collapse margins. */
    display: flex;
    flex-direction: column;
    margin: var(--hero-headline-pull, -0.52em) 0 0;
    /* Tighter than .display-hero's 0.93: this pair is lowercase, and line one
       has no descenders, so the space under it reads as a gap. One token in
       themes/southwell.css. */
    line-height: var(--hero-leading, 0.88);
    /* Sized to the shell, not the viewport: the second line is about 12.4em
       of light Outfit at this tracking, and 7.7cqi puts it at roughly 95% of
       the container's width at every size — one row per line on a phone as
       well as on a 1440px shell. The shell caps at 1440px, so this caps
       itself. */
    font-size: 7.7cqi;
  }

  /* Each line masks its word so it rises out from behind the line above.
     A line-height under 1 makes the line box SHORTER than the glyphs, so the
     mask has to be padded out vertically or it shears the ascenders and
     descenders off — the negative margins put the layout back exactly where
     it was (see the flex note on .hero__headline). 0.2em covers the p in
     "apps" at 0.88 leading with room to spare. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.2em;
    margin-block: -0.2em;
  }

  /* The words rise inside their masks and nowhere else: the mask is a tight
     box tuned to this line-height, so anything but a flat vertical travel
     would shear the glyphs against its edge. */
  .hero__word {
    display: block;
  }

  .hero__baseline {
    display: inline-block;
    width: 0;
    height: 0;
    vertical-align: baseline;
  }

  .hero__fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 38%,
      color-mix(in srgb, var(--color-background) 55%, transparent) 72%,
      var(--color-background) 100%
    );
  }

  /* Answers the scroll while the stage is pinned. `translate`, not
     `transform`: the entrance (hero.ts) owns transform and opacity on the
     foot itself, so the scroll response lives beside it, on the children. */
  .hero__foot {
    translate: 0 var(--hero-foot-y, 0px);
  }

  .hero__foot > * {
    opacity: var(--hero-foot-o, 1);
  }

  .hero__scroll {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-foreground-muted);
  }

  .hero__scroll-line {
    display: block;
    width: 1.5px;
    height: 48px;
    background: var(--color-foreground);
    animation: sw-scrollpulse 1.8s ease-in-out infinite;
  }

  @media (max-width: 700px) {
    .hero__headline {
      margin-top: var(--hero-headline-pull-sm, -0.4em);
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__render,
    .hero__word,
    .hero__foot {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
