---
/**
 * Giant section title paired with a short right-hand blurb. Shared by Work and
 * Services so the two headers stay identical.
 *
 * The title rises out of a mask as the header comes into view; the blurb
 * lifts in a beat later. Both are [data-reveal] variants, see
 * src/scripts/motion/reveal.ts.
 *
 * `immediate` is for a header that opens the page. The title becomes the
 * page's h1, and the blurb, usually the largest thing on screen, paints with
 * the page rather than waiting on the motion bundle: that wait is what the
 * page's load time is scored on.
 */
interface Props {
  title: string;
  blurb: string;
  /** Opens the page: an h1 title, and a blurb that paints at once. */
  immediate?: boolean;
  id?: string;
  class?: string;
}

const { title, blurb, immediate = false, id, class: className } = Astro.props;
const Heading = immediate ? 'h1' : 'h2';
---

<header
  class:list={[
    'flex items-baseline justify-between gap-10',
    'max-[800px]:flex-col max-[800px]:items-start max-[800px]:gap-5',
    className,
  ]}
>
  <Heading class="display-section m-0" id={id}>
    <span class="sh__mask"><span class="sh__word" data-reveal="rise">{title}</span></span>
  </Heading>
  <p
    class="text-foreground-secondary m-0 max-w-[380px] text-[18px] leading-[1.55] max-[800px]:text-base"
    data-reveal={immediate ? undefined : ''}
    data-reveal-delay={immediate ? undefined : '0.15'}
  >
    {blurb}
  </p>
</header>

<style>
  /* Padded so the mask never shears a descender off the title. */
  .sh__mask {
    display: block;
    overflow: clip;
    padding-block: 0.12em;
    margin-block: -0.12em;
  }

  .sh__word {
    display: block;
  }
</style>
